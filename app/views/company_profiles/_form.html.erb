<%= form_with(model: @company_profile, url: company_profile_path, method: :patch, class: "form-card") do |form| %>
  <% if @company_profile.errors.any? %>
    <div class="form-errors">
      <h3><%= pluralize(@company_profile.errors.count, "error") %> stopped this from saving:</h3>
      <ul>
        <% @company_profile.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-grid">
    <div class="field">
      <%= form.label :company_name, "Company Name" %>
      <%= form.text_field :company_name, placeholder: "Acme Trucking LLC" %>
    </div>

    <div class="two-col">
      <div class="field">
        <%= form.label :address_line1, "Address Line 1" %>
        <%= form.text_field :address_line1, placeholder: "123 Main St" %>
      </div>
      <div class="field">
        <%= form.label :address_line2, "Address Line 2" %>
        <%= form.text_field :address_line2, placeholder: "Suite / Unit" %>
      </div>
    </div>

    <div class="three-col">
      <div class="field">
        <%= form.label :city, "City" %>
        <%= form.text_field :city %>
      </div>
      <div class="field">
        <%= form.label :state, "State" %>
        <%= form.text_field :state %>
      </div>
      <div class="field">
        <%= form.label :zip, "ZIP" %>
        <%= form.text_field :zip %>
      </div>
    </div>

    <div class="two-col">
      <div class="field">
        <%= form.label :phone, "Phone" %>
        <%= form.text_field :phone, placeholder: "(555) 555-1212" %>
      </div>
      <div class="field">
        <%= form.label :email, "Email" %>
        <%= form.email_field :email, placeholder: "billing@company.com" %>
      </div>
    </div>

    <div class="two-col">
      <div class="field">
        <%= form.label :dot_number, "DOT Number" %>
        <%= form.text_field :dot_number %>
      </div>
      <div class="field">
        <%= form.label :mc_number, "MC Number" %>
        <%= form.text_field :mc_number %>
      </div>
    </div>

    <div class="action-bar">
      <%= form.submit "Save Company Profile" %>
    </div>
  </div>
<% end %>
