<% content_for :title, "Company Profile" %>

<div class="page-header">
  <div class="page-title-group">
    <h1>Company Profile</h1>
    <p class="page-kicker">This information appears on invoice headers and reports.</p>
  </div>
  <div class="action-bar">
    <%= link_to "Edit Company Profile", edit_company_profile_path, class: "btn" %>
  </div>
</div>

<div class="metric-grid">
  <div class="metric-card">
    <div class="metric-label">Company</div>
    <div class="metric-value"><%= @company_profile.company_name.presence || "Add Company Name" %></div>
  </div>
  <div class="metric-card">
    <div class="metric-label">Address</div>
    <div class="metric-note">
      <%= @company_profile.address_line1 %><br>
      <%= @company_profile.address_line2 %><br>
      <%= @company_profile.city_state_zip %>
    </div>
  </div>
  <div class="metric-card">
    <div class="metric-label">Contact</div>
    <div class="metric-note">
      <%= @company_profile.phone %><br>
      <%= @company_profile.email %><br>
      DOT: <%= @company_profile.dot_number %><br>
      MC: <%= @company_profile.mc_number %>
    </div>
  </div>
</div>
