<%= form_with(model: depreciation_asset, class: "form-card") do |form| %>
  <% if depreciation_asset.errors.any? %>
    <div class="form-errors">
      <h3><%= pluralize(depreciation_asset.errors.count, "error") %> stopped this asset from saving:</h3>
      <ul>
        <% depreciation_asset.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-grid">
    <div class="two-col">
      <div class="field">
        <%= form.label :name, "Asset Name" %>
        <%= form.text_field :name, placeholder: "2023 Peterbilt 579" %>
      </div>
      <div class="field">
        <%= form.label :asset_type, "Asset Type" %>
        <%= form.select :asset_type, [["Truck", "truck"], ["Trailer", "trailer"], ["Equipment", "equipment"], ["Other", "other"]] %>
      </div>
    </div>

    <div class="field">
      <%= form.label :truck_id, "Linked Truck" %>
      <%= form.collection_select :truck_id, @trucks, :id, :display_name, { include_blank: "Not tied to a specific truck" } %>
    </div>

    <div class="three-col">
      <div class="field">
        <%= form.label :placed_in_service_date, "Placed In Service" %>
        <%= form.date_field :placed_in_service_date %>
      </div>
      <div class="field">
        <%= form.label :cost_basis, "Cost Basis ($)" %>
        <%= form.number_field :cost_basis, step: "0.01" %>
      </div>
      <div class="field">
        <%= form.label :salvage_value, "Salvage Value ($)" %>
        <%= form.number_field :salvage_value, step: "0.01" %>
      </div>
    </div>

    <div class="two-col">
      <div class="field">
        <%= form.label :recovery_period_years, "Recovery Period (Years)" %>
        <%= form.number_field :recovery_period_years, min: 1 %>
      </div>
      <div class="field">
        <%= form.label :depreciation_method, "Method" %>
        <%= form.select :depreciation_method, [["Straight Line", "straight_line"], ["Double Declining Balance", "double_declining_balance"], ["Section 179", "section_179"]] %>
      </div>
    </div>

    <% estimated_annual_deduction = depreciation_asset.cost_basis.present? && depreciation_asset.recovery_period_years.present? ? depreciation_asset.annual_deduction : 0 %>
    <div class="note-box">
      Estimated annual deduction: <strong>$<%= number_with_precision(estimated_annual_deduction, precision: 2) %></strong>
    </div>

    <div class="field">
      <%= form.label :notes, "Notes" %>
      <%= form.text_area :notes, rows: 3 %>
    </div>

    <div class="action-bar">
      <%= form.submit depreciation_asset.persisted? ? "Update Asset" : "Save Asset" %>
    </div>
  </div>
<% end %>
