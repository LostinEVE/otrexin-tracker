<% content_for :title, "Depreciation Assets" %>

<div class="page-header">
  <div class="page-title-group">
    <h1>Depreciation Assets</h1>
    <p class="page-kicker">Track trucks, trailers, equipment, and other depreciable assets for tax estimates.</p>
  </div>
  <div class="action-bar">
    <%= link_to "Add Asset", new_depreciation_asset_path, class: "btn" %>
    <%= link_to "Back to Taxes", tax_payments_path, class: "btn btn-secondary" %>
  </div>
</div>

<div class="record-list">
  <% if @depreciation_assets.any? %>
    <% @depreciation_assets.each do |asset| %>
      <div class="record-card">
        <div class="record-main">
          <div>
            <h3 class="record-title"><%= asset.name %></h3>
            <div class="record-subtitle">
              <%= asset.asset_type.to_s.humanize %>
              <% if asset.truck.present? %>
                - <%= asset.truck.display_name %>
              <% end %>
            </div>
          </div>
          <div class="record-amount text-info">$<%= number_with_precision(asset.deduction_for_year(Date.current.year), precision: 2) %></div>
        </div>

        <div class="record-meta-grid">
          <div class="meta-item">
            <div class="meta-label">Placed in Service</div>
            <div class="meta-value"><%= asset.placed_in_service_date %></div>
          </div>
          <div class="meta-item">
            <div class="meta-label">Cost Basis</div>
            <div class="meta-value">$<%= number_with_precision(asset.cost_basis, precision: 2) %></div>
          </div>
          <div class="meta-item">
            <div class="meta-label">Recovery</div>
            <div class="meta-value"><%= asset.recovery_period_years %> years</div>
          </div>
          <div class="meta-item">
            <div class="meta-label">Annual Estimate</div>
            <div class="meta-value">$<%= number_with_precision(asset.annual_deduction, precision: 2) %></div>
          </div>
        </div>

        <% if asset.notes.present? %>
          <p class="record-note"><%= asset.notes %></p>
        <% end %>

        <div class="record-actions">
          <%= link_to "Edit", edit_depreciation_asset_path(asset), class: "btn btn-secondary" %>
          <%= link_to "Delete", depreciation_asset_path(asset), data: { turbo_method: :delete, turbo_confirm: "Delete this depreciation asset?" }, class: "btn btn-danger" %>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="empty-state">No depreciation assets yet.</div>
  <% end %>
</div>
