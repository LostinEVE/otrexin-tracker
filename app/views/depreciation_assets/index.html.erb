<p style="color: green"><%= notice %></p>

<% content_for :title, "Depreciation Assets" %>

<h1>Depreciation Assets</h1>
<p style="color:#5f6c80;max-width:760px;">Add trucks, trailers, equipment, and other depreciable assets here. The tax workspace uses straight-line depreciation to estimate the current deduction.</p>

<div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px;">
  <%= link_to "Add Asset", new_depreciation_asset_path, style: "padding:10px 14px;font-weight:700;display:inline-block;" %>
  <%= link_to "Back to Taxes", tax_payments_path, style: "padding:10px 14px;font-weight:700;display:inline-block;" %>
</div>

<div style="display:grid;gap:10px;max-width:860px;">
  <% @depreciation_assets.each do |asset| %>
    <div style="padding:14px;border:1px solid #ddd;border-radius:8px;display:grid;gap:6px;">
      <div style="display:flex;justify-content:space-between;gap:10px;align-items:center;">
        <strong><%= asset.name %></strong>
        <strong style="color:#0d6efd;">$<%= number_with_precision(asset.deduction_for_year(Date.current.year), precision: 2) %></strong>
      </div>
      <div style="font-size:14px;color:#555;"><%= asset.asset_type.to_s.humanize %> <% if asset.truck.present? %>• <%= asset.truck.display_name %><% end %></div>
      <div style="font-size:14px;color:#555;">Placed in service: <%= asset.placed_in_service_date %> • Cost basis: $<%= number_with_precision(asset.cost_basis, precision: 2) %> • Recovery: <%= asset.recovery_period_years %> years</div>
      <div style="font-size:14px;color:#555;">Annual straight-line estimate: $<%= number_with_precision(asset.annual_deduction, precision: 2) %></div>
      <% if asset.notes.present? %>
        <div style="font-size:13px;color:#666;"><%= asset.notes %></div>
      <% end %>
      <div style="display:flex;gap:8px;flex-wrap:wrap;">
        <%= link_to "Edit", edit_depreciation_asset_path(asset), style: "padding:8px 12px;font-weight:700;display:inline-block;" %>
        <%= link_to "Delete", depreciation_asset_path(asset), data: { turbo_method: :delete, turbo_confirm: "Delete this depreciation asset?" }, style: "padding:8px 12px;font-weight:700;display:inline-block;color:#7f1d1d;" %>
      </div>
    </div>
  <% end %>
</div>