<%= form_with(model: per_diem_entry, class: "form-card") do |form| %>
  <% if per_diem_entry.errors.any? %>
    <div class="form-errors">
      <h3><%= pluralize(per_diem_entry.errors.count, "error") %> stopped this per diem entry from saving:</h3>
      <ul>
        <% per_diem_entry.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-grid">
    <div class="field">
      <%= form.label :truck_id, "Truck" %>
      <%= form.collection_select :truck_id, @trucks, :id, :display_name, { include_blank: "All trucks / account-level" } %>
    </div>

    <div class="two-col">
      <div class="field">
        <%= form.label :start_date, "Start Date" %>
        <%= form.date_field :start_date %>
      </div>
      <div class="field">
        <%= form.label :end_date, "End Date" %>
        <%= form.date_field :end_date %>
      </div>
    </div>

    <div class="two-col">
      <div class="field">
        <%= form.label :qualifying_days, "Qualifying Days" %>
        <%= form.number_field :qualifying_days, min: 1 %>
      </div>
      <div class="field">
        <%= form.label :daily_rate, "Daily Rate ($)" %>
        <%= form.number_field :daily_rate, step: "0.01" %>
      </div>
    </div>

    <% estimated_deduction = per_diem_entry.qualifying_days.present? && per_diem_entry.daily_rate.present? ? per_diem_entry.deduction_amount : 0 %>
    <div class="note-box">
      Estimated deduction: <strong>$<%= number_with_precision(estimated_deduction, precision: 2) %></strong>
    </div>

    <div class="field">
      <%= form.label :notes, "Notes" %>
      <%= form.text_area :notes, rows: 3 %>
    </div>

    <div class="action-bar">
      <%= form.submit per_diem_entry.persisted? ? "Update Entry" : "Save Entry" %>
    </div>
  </div>
<% end %>
