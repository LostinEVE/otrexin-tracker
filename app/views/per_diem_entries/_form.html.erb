<%= form_with(model: per_diem_entry) do |form| %>
  <% if per_diem_entry.errors.any? %>
    <div style="color:#b00020;margin-bottom:12px;">
      <h3><%= pluralize(per_diem_entry.errors.count, "error") %> stopped this per diem entry from saving:</h3>
      <ul>
        <% per_diem_entry.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div style="display:grid;gap:10px;max-width:620px;">
    <div>
      <%= form.label :truck_id, "Truck (optional)", style: "display:block;font-weight:600;" %>
      <%= form.collection_select :truck_id, @trucks, :id, :display_name,
          { include_blank: "All trucks / account-level" },
          style: "width:100%;padding:10px;" %>
    </div>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px;">
      <div>
        <%= form.label :start_date, "Start Date", style: "display:block;font-weight:600;" %>
        <%= form.date_field :start_date, style: "width:100%;padding:10px;" %>
      </div>
      <div>
        <%= form.label :end_date, "End Date", style: "display:block;font-weight:600;" %>
        <%= form.date_field :end_date, style: "width:100%;padding:10px;" %>
      </div>
    </div>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px;">
      <div>
        <%= form.label :qualifying_days, "Qualifying Days", style: "display:block;font-weight:600;" %>
        <%= form.number_field :qualifying_days, min: 1, style: "width:100%;padding:10px;" %>
      </div>
      <div>
        <%= form.label :daily_rate, "Daily Rate ($)", style: "display:block;font-weight:600;" %>
        <%= form.number_field :daily_rate, step: "0.01", style: "width:100%;padding:10px;" %>
      </div>
    </div>

    <div style="padding:10px;background:#f8f9fa;border-radius:8px;font-size:14px;">
      Estimated deduction: <strong>$<%= number_with_precision(per_diem_entry.deduction_amount, precision: 2) rescue '0.00' %></strong>
    </div>

    <div>
      <%= form.label :notes, "Notes", style: "display:block;font-weight:600;" %>
      <%= form.text_area :notes, rows: 3, style: "width:100%;padding:10px;" %>
    </div>

    <div>
      <%= form.submit per_diem_entry.persisted? ? "Update Entry" : "Save Entry", style: "padding:12px 24px;font-weight:700;font-size:16px;" %>
    </div>
  </div>
<% end %>