<p style="color: green"><%= notice %></p>

<% content_for :title, "Per Diem" %>

<h1>Per Diem Tax Prep</h1>
<p style="color:#5f6c80;max-width:760px;">Track qualifying travel days here so the tax workspace can include per diem deductions alongside normal operating expenses.</p>

<div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px;">
  <%= link_to "Add Per Diem Entry", new_per_diem_entry_path, style: "padding:10px 14px;font-weight:700;display:inline-block;" %>
  <%= link_to "Back to Taxes", tax_payments_path, style: "padding:10px 14px;font-weight:700;display:inline-block;" %>
</div>

<div style="display:grid;gap:10px;max-width:840px;">
  <% @per_diem_entries.each do |entry| %>
    <div style="padding:14px;border:1px solid #ddd;border-radius:8px;display:grid;gap:6px;">
      <div style="display:flex;justify-content:space-between;gap:10px;align-items:center;">
        <strong><%= entry.start_date %> to <%= entry.end_date %></strong>
        <strong style="color:#0f5132;">$<%= number_with_precision(entry.deduction_amount, precision: 2) %></strong>
      </div>
      <div style="font-size:14px;color:#555;">Truck: <%= entry.truck&.display_name || 'All trucks / account-level' %></div>
      <div style="font-size:14px;color:#555;">Qualifying days: <%= entry.qualifying_days %> at $<%= number_with_precision(entry.daily_rate, precision: 2) %>/day</div>
      <% if entry.notes.present? %>
        <div style="font-size:13px;color:#666;"><%= entry.notes %></div>
      <% end %>
      <div style="display:flex;gap:8px;flex-wrap:wrap;">
        <%= link_to "Edit", edit_per_diem_entry_path(entry), style: "padding:8px 12px;font-weight:700;display:inline-block;" %>
        <%= link_to "Delete", per_diem_entry_path(entry), data: { turbo_method: :delete, turbo_confirm: "Delete this per diem entry?" }, style: "padding:8px 12px;font-weight:700;display:inline-block;color:#7f1d1d;" %>
      </div>
    </div>
  <% end %>
</div>