<% content_for :title, "Per Diem" %>

<div class="page-header">
  <div class="page-title-group">
    <h1>Per Diem Tax Prep</h1>
    <p class="page-kicker">Track qualifying travel days for per diem deduction estimates.</p>
  </div>
  <div class="action-bar">
    <%= link_to "Add Per Diem Entry", new_per_diem_entry_path, class: "btn" %>
    <%= link_to "Back to Taxes", tax_payments_path, class: "btn btn-secondary" %>
  </div>
</div>

<div class="record-list">
  <% if @per_diem_entries.any? %>
    <% @per_diem_entries.each do |entry| %>
      <div class="record-card">
        <div class="record-main">
          <div>
            <h3 class="record-title"><%= entry.start_date %> to <%= entry.end_date %></h3>
            <div class="record-subtitle"><%= entry.truck&.display_name || "All trucks / account-level" %></div>
          </div>
          <div class="record-amount">$<%= number_with_precision(entry.deduction_amount, precision: 2) %></div>
        </div>

        <div class="record-meta-grid">
          <div class="meta-item">
            <div class="meta-label">Qualifying Days</div>
            <div class="meta-value"><%= entry.qualifying_days %></div>
          </div>
          <div class="meta-item">
            <div class="meta-label">Daily Rate</div>
            <div class="meta-value">$<%= number_with_precision(entry.daily_rate, precision: 2) %></div>
          </div>
        </div>

        <% if entry.notes.present? %>
          <p class="record-note"><%= entry.notes %></p>
        <% end %>

        <div class="record-actions">
          <%= link_to "Edit", edit_per_diem_entry_path(entry), class: "btn btn-secondary" %>
          <%= link_to "Delete", per_diem_entry_path(entry), data: { turbo_method: :delete, turbo_confirm: "Delete this per diem entry?" }, class: "btn btn-danger" %>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="empty-state">No per diem entries yet.</div>
  <% end %>
</div>
