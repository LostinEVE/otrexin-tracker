<%= form_with(model: expense, class: "form-card") do |form| %>
  <% if expense.errors.any? %>
    <div class="form-errors">
      <h3><%= pluralize(expense.errors.count, "error") %> stopped this expense from saving:</h3>
      <ul>
        <% expense.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-grid">
    <div class="field">
      <%= form.label :truck_id, "Truck" %>
      <%= form.collection_select :truck_id, @trucks, :id, :display_name, { prompt: "Select a truck" } %>
    </div>

    <div class="two-col">
      <div class="field">
        <%= form.label :expense_date, "Date" %>
        <%= form.date_field :expense_date %>
      </div>
      <div class="field">
        <%= form.label :category, "Category" %>
        <%= form.select :category, [
          ["Fuel", "fuel"],
          ["Maintenance & Repairs", "maintenance"],
          ["Tolls & Parking", "tolls"],
          ["Food & Meals", "food"],
          ["Insurance", "insurance"],
          ["Permits & Licenses", "permits"],
          ["Truck Payment / Lease", "truck_payment"],
          ["Supplies", "supplies"],
          ["Drivers Pay", "drivers_pay"],
          ["Truck Wash / Hopper Washout", "truck_wash_hopper_washout"],
          ["Other", "other"]
        ], { prompt: "Select a category" }, id: "expense_category", onchange: "document.getElementById('gallons_group').classList.toggle('is-hidden', this.value !== 'fuel')" %>
      </div>
    </div>

    <div id="gallons_group" class="field <%= 'is-hidden' unless expense.category == 'fuel' %>">
      <%= form.label :gallons, "Gallons" %>
      <%= form.number_field :gallons, step: "0.001", placeholder: "150.500" %>
    </div>

    <div class="two-col">
      <div class="field">
        <%= form.label :vendor, "Vendor / Location" %>
        <%= form.text_field :vendor, placeholder: "Flying J, Love's, TA..." %>
      </div>
      <div class="field">
        <%= form.label :amount, "Amount ($)" %>
        <%= form.number_field :amount, step: "0.01", placeholder: "0.00" %>
      </div>
    </div>

    <div class="field">
      <%= form.label :notes, "Notes" %>
      <%= form.text_area :notes, rows: 3, placeholder: "Any extra details..." %>
    </div>

    <div class="action-bar">
      <%= form.submit "Save Expense" %>
    </div>
  </div>
<% end %>
