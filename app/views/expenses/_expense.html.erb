<div id="<%= dom_id expense %>" class="record-card">
  <div class="record-main">
    <div>
      <h3 class="record-title"><%= expense_category_label(expense.category) %></h3>
      <div class="record-subtitle"><%= expense.expense_date %> - <%= expense.vendor.presence || "No vendor" %></div>
    </div>
    <div class="record-amount text-danger">$<%= number_with_precision(expense.amount, precision: 2) %></div>
  </div>

  <div class="record-meta-grid">
    <div class="meta-item">
      <div class="meta-label">Truck</div>
      <div class="meta-value"><%= expense.truck&.display_name || "No truck" %></div>
    </div>
    <div class="meta-item">
      <div class="meta-label">Category</div>
      <div class="meta-value"><%= expense_category_label(expense.category) %></div>
    </div>
    <% if expense.gallons.present? %>
      <div class="meta-item">
        <div class="meta-label">Gallons</div>
        <div class="meta-value"><%= expense.gallons %></div>
      </div>
    <% end %>
  </div>

  <% if expense.notes.present? %>
    <p class="record-note"><%= expense.notes %></p>
  <% end %>

  <div class="record-actions">
    <%= link_to "View", expense, class: "btn btn-secondary" %>
    <%= link_to "Edit", edit_expense_path(expense), class: "btn btn-secondary" %>
  </div>
</div>
