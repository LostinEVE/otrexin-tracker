<% content_for :title, "Expense" %>

<div class="page-header">
  <div class="page-title-group">
    <h1>Expense</h1>
  </div>
</div>

<%= render @expense %>

<div class="page-footer-actions">
  <%= link_to "Edit Expense", edit_expense_path(@expense), class: "btn btn-secondary" %>
  <%= link_to "Back to Expenses", expenses_path, class: "btn btn-secondary" %>
  <%= button_to "Delete Expense", @expense, method: :delete, class: "btn btn-danger" %>
</div>
