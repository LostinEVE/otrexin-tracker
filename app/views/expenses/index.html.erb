<% content_for :title, "Expenses" %>

<div class="page-header">
  <div class="page-title-group">
    <h1>Expenses</h1>
    <p class="page-kicker">Track operating costs by truck, date range, and category.</p>
  </div>
  <div class="action-bar">
    <%= link_to "Export CSV", expenses_path(format: :csv, truck_id: selected_truck&.id, start_date: @start_date, end_date: @end_date), class: "btn btn-secondary" %>
    <%= link_to "New Expense", new_expense_path(truck_id: selected_truck&.id), class: "btn" %>
  </div>
</div>

<%= form_with url: expenses_path, method: :get, local: true, class: "filter-bar" do |f| %>
  <div class="field">
    <%= f.label :truck_id, "Truck" %>
    <%= f.select :truck_id,
      options_from_collection_for_select(@trucks, :id, :display_name, selected_truck&.id),
      { include_blank: "All trucks" } %>
  </div>
  <div class="field">
    <%= f.label :start_date, "Start Date" %>
    <%= f.date_field :start_date, value: @start_date %>
  </div>
  <div class="field">
    <%= f.label :end_date, "End Date" %>
    <%= f.date_field :end_date, value: @end_date %>
  </div>
  <div class="field">
    <%= f.submit "Filter" %>
  </div>
<% end %>

<% if @expense_by_category.any? %>
  <section class="panel">
    <div class="panel-header">
      <h3 class="panel-title">Expense Summary</h3>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Category</th>
            <th class="align-right">Total</th>
          </tr>
        </thead>
        <tbody>
          <% @expense_by_category.each do |cat, amt| %>
            <tr>
              <td><%= expense_category_label(cat) %></td>
              <td class="align-right text-danger"><strong>$<%= number_with_precision(amt, precision: 2, delimiter: ",") %></strong></td>
            </tr>
          <% end %>
          <tr>
            <td><strong>Total</strong></td>
            <td class="align-right text-danger"><strong>$<%= number_with_precision(@expense_total, precision: 2, delimiter: ",") %></strong></td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
<% end %>

<h2 class="section-title">Expense Records</h2>
<div id="expenses" class="record-list">
  <% if @expenses.any? %>
    <% @expenses.each do |expense| %>
      <%= render expense %>
    <% end %>
  <% else %>
    <div class="empty-state">No expenses found for this filter.</div>
  <% end %>
</div>
