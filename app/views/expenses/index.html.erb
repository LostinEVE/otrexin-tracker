<% category_labels = {
  "fuel" => "Fuel",
  "maintenance" => "Maintenance & Repairs",
  "tolls" => "Tolls & Parking",
  "food" => "Food & Meals",
  "insurance" => "Insurance",
  "permits" => "Permits & Licenses",
  "truck_payment" => "Truck Payment / Lease",
  "supplies" => "Supplies",
  "drivers_pay" => "Drivers Pay",
  "truck_wash_hopper_washout" => "Truck Wash / Hopper Washout",
  "other" => "Other"
} %>

<p style="color: green"><%= notice %></p>

<% content_for :title, "Expenses" %>

<h1>Expenses</h1>

<%= form_with url: expenses_path, method: :get, local: true, style: "display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px;max-width:700px;margin-bottom:12px;" do |f| %>
  <div>
    <%= f.label :truck_id, "Truck", style: "display:block;font-weight:600;" %>
    <%= f.select :truck_id,
      options_from_collection_for_select(@trucks, :id, :display_name, selected_truck&.id),
        { include_blank: "All trucks" },
        style: "padding:10px;width:100%;" %>
  </div>
  <div>
    <%= f.label :start_date, "Start Date", style: "display:block;font-weight:600;" %>
    <%= f.date_field :start_date, value: @start_date %>
  </div>
  <div>
    <%= f.label :end_date, "End Date", style: "display:block;font-weight:600;" %>
    <%= f.date_field :end_date, value: @end_date %>
  </div>
  <div style="align-self:end;display:flex;gap:8px;">
    <%= f.submit "Filter", style: "padding:10px 14px;font-weight:700;" %>
  </div>
<% end %>

<div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px;">
  <%= link_to "Export Expense Report (CSV)", expenses_path(format: :csv, truck_id: selected_truck&.id, start_date: @start_date, end_date: @end_date), style: "padding:10px 14px;font-weight:700;display:inline-block;" %>
  <%= link_to "New Expense", new_expense_path(truck_id: selected_truck&.id), style: "padding:10px 14px;font-weight:700;display:inline-block;" %>
</div>

<% if @expense_by_category.any? %>
  <div style="border:1px solid #d8dee8;border-radius:10px;padding:14px;margin-bottom:20px;background:#fafafa;">
    <h3 style="margin:0 0 10px;">Expense Summary</h3>
    <table style="width:100%;max-width:500px;border-collapse:collapse;font-size:14px;">
      <thead>
        <tr style="background:#f0f0f0;">
          <th style="text-align:left;padding:7px 8px;">Category</th>
          <th style="text-align:right;padding:7px 8px;">Total</th>
        </tr>
      </thead>
      <tbody>
        <% @expense_by_category.each do |cat, amt| %>
          <tr style="border-bottom:1px solid #eee;">
            <td style="padding:6px 8px;"><%= category_labels[cat] || cat.to_s.humanize %></td>
            <td style="padding:6px 8px;text-align:right;font-weight:600;color:#721c24;">$<%= number_with_precision(amt, precision: 2, delimiter: ',') %></td>
          </tr>
        <% end %>
        <tr style="background:#f5f5f5;font-weight:700;border-top:2px solid #ccc;">
          <td style="padding:7px 8px;">Total</td>
          <td style="padding:7px 8px;text-align:right;color:#721c24;">$<%= number_with_precision(@expense_total, precision: 2, delimiter: ',') %></td>
        </tr>
      </tbody>
    </table>
  </div>
<% end %>

<div id="expenses">
  <% @expenses.each do |expense| %>
    <%= render expense %>
    <div style="margin-bottom:6px;">
      <%= link_to "Show", expense %> |
      <%= link_to "Edit", edit_expense_path(expense) %>
    </div>
  <% end %>
</div>
