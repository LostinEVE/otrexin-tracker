<% content_for :title, "Mileage" %>

<div class="page-header">
  <div class="page-title-group">
    <h1>Mileage</h1>
    <p class="page-kicker">Track trips, loaded miles, and lane revenue by truck.</p>
  </div>
  <div class="action-bar">
    <%= link_to "New Mileage Entry", new_mileage_path(truck_id: selected_truck&.id), class: "btn" %>
  </div>
</div>

<%= form_with url: mileages_path, method: :get, local: true, class: "filter-bar" do |f| %>
  <div class="field">
    <%= f.label :truck_id, "Truck" %>
    <%= f.select :truck_id,
      options_from_collection_for_select(@trucks, :id, :display_name, selected_truck&.id),
      { include_blank: "All trucks" } %>
  </div>
  <div class="field">
    <%= f.label :start_date, "Start Date" %>
    <%= f.date_field :start_date, value: @start_date %>
  </div>
  <div class="field">
    <%= f.label :end_date, "End Date" %>
    <%= f.date_field :end_date, value: @end_date %>
  </div>
  <div class="field">
    <%= f.submit "Filter" %>
  </div>
<% end %>

<div class="metric-grid is-compact">
  <div class="metric-card">
    <div class="metric-label">Total Miles</div>
    <div class="metric-value"><%= number_with_precision(@total_miles, precision: 1, delimiter: ",") %></div>
  </div>
  <div class="metric-card">
    <div class="metric-label">Trip Revenue</div>
    <div class="metric-value text-success">$<%= number_with_precision(@total_revenue, precision: 2, delimiter: ",") %></div>
  </div>
  <div class="metric-card">
    <div class="metric-label">Revenue / Mile</div>
    <div class="metric-value"><%= @revenue_per_mile ? "$#{@revenue_per_mile}" : "-" %></div>
  </div>
  <div class="metric-card">
    <div class="metric-label">Cost / Mile</div>
    <div class="metric-value"><%= @cost_per_mile ? "$#{@cost_per_mile}" : "-" %></div>
  </div>
</div>

<div id="mileages" class="record-list">
  <% if @mileages.any? %>
    <% @mileages.each do |mileage| %>
      <%= render mileage %>
    <% end %>
  <% else %>
    <div class="empty-state">No mileage entries yet.</div>
  <% end %>
</div>
