<% content_for :title, "Mileage Entry" %>

<div class="page-header">
  <div class="page-title-group">
    <h1>Mileage Entry</h1>
  </div>
</div>

<%= render @mileage %>

<div class="page-footer-actions">
  <%= link_to "Edit Entry", edit_mileage_path(@mileage), class: "btn btn-secondary" %>
  <%= link_to "Back to Mileage", mileages_path, class: "btn btn-secondary" %>
  <%= button_to "Delete Entry", @mileage, method: :delete, class: "btn btn-danger" %>
</div>
