<%= form_with(model: tax_payment, class: "form-card") do |form| %>
  <% if tax_payment.errors.any? %>
    <div class="form-errors">
      <h3><%= pluralize(tax_payment.errors.count, "error") %> stopped this from saving:</h3>
      <ul>
        <% tax_payment.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-grid">
    <div class="two-col">
      <div class="field">
        <%= form.label :payment_date, "Payment Date" %>
        <%= form.date_field :payment_date %>
      </div>
      <div class="field">
        <%= form.label :quarter, "Quarter" %>
        <%= form.select :quarter,
          [["Q1 (Jan-Mar)", "Q1"], ["Q2 (Apr-Jun)", "Q2"], ["Q3 (Jul-Sep)", "Q3"], ["Q4 (Oct-Dec)", "Q4"]],
          { include_blank: "Select" } %>
      </div>
    </div>
    <div class="field">
      <%= form.label :amount, "Amount ($)" %>
      <%= form.number_field :amount, step: "0.01", placeholder: "0.00" %>
    </div>
    <div class="field">
      <%= form.label :notes, "Notes" %>
      <%= form.text_area :notes, rows: 2 %>
    </div>
    <div class="action-bar">
      <%= form.submit "Save Payment" %>
    </div>
  </div>
<% end %>
