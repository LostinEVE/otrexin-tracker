<% content_for :title, "Tax Payment" %>

<div class="page-header">
  <div class="page-title-group">
    <h1>Tax Payment</h1>
  </div>
</div>

<%= render @tax_payment %>

<div class="page-footer-actions">
  <%= link_to "Edit Payment", edit_tax_payment_path(@tax_payment), class: "btn btn-secondary" %>
  <%= link_to "Back to Taxes", tax_payments_path, class: "btn btn-secondary" %>
  <%= button_to "Delete Payment", @tax_payment, method: :delete, class: "btn btn-danger" %>
</div>
