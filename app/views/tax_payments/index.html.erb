<% content_for :title, "Tax Estimator" %>

<% year = Date.current.year
   summary = @tax_summary
   ytd_revenue = summary.revenue
   ytd_expenses = summary.operating_expenses
   ytd_per_diem = summary.per_diem_deductions
   ytd_depreciation = summary.depreciation_deductions
   ytd_profit = summary.business_profit
   se_tax = summary.self_employment_tax
   income_tax = summary.income_tax
   total_owed = summary.total_owed
   quarterly_estimate = summary.quarterly_estimate
   ytd_paid = summary.ytd_paid
   remaining = summary.remaining_balance

   quarters = {
     "Q1" => { label: "Q1 (Jan-Mar)", deadline: "April 15" },
     "Q2" => { label: "Q2 (Apr-Jun)", deadline: "June 15" },
     "Q3" => { label: "Q3 (Jul-Sep)", deadline: "September 15" },
     "Q4" => { label: "Q4 (Oct-Dec)", deadline: "January 15" }
   }
   current_quarter = case Date.current.month
                     when 1..3 then "Q1"
                     when 4..6 then "Q2"
                     when 7..9 then "Q3"
                     else "Q4"
                     end %>

<div class="page-header">
  <div class="page-title-group">
    <h1>Tax Estimator</h1>
    <p class="page-kicker">Estimate quarterly federal tax needs from current revenue, expenses, per diem, depreciation, and tax payments.</p>
  </div>
</div>

<div class="metric-grid is-compact">
  <div class="metric-card">
    <div class="metric-label">YTD Profit</div>
    <div class="metric-value <%= ytd_profit >= 0 ? 'text-success' : 'text-danger' %>">$<%= number_with_precision(ytd_profit, precision: 2, delimiter: ",") %></div>
    <div class="metric-note">
      Rev: $<%= number_with_precision(ytd_revenue, precision: 2, delimiter: ",") %><br>
      Ops: $<%= number_with_precision(ytd_expenses, precision: 2, delimiter: ",") %><br>
      Per diem: $<%= number_with_precision(ytd_per_diem, precision: 2, delimiter: ",") %><br>
      Dep: $<%= number_with_precision(ytd_depreciation, precision: 2, delimiter: ",") %>
    </div>
  </div>
  <div class="metric-card">
    <div class="metric-label">Estimated Tax Owed</div>
    <div class="metric-value text-warning">$<%= number_with_precision(total_owed, precision: 2, delimiter: ",") %></div>
    <div class="metric-note">SE: $<%= number_with_precision(se_tax, precision: 2, delimiter: ",") %><br>Income: $<%= number_with_precision(income_tax, precision: 2, delimiter: ",") %></div>
  </div>
  <div class="metric-card">
    <div class="metric-label">Paid So Far</div>
    <div class="metric-value text-success">$<%= number_with_precision(ytd_paid, precision: 2, delimiter: ",") %></div>
    <div class="metric-note"><%= @tax_payments.count { |p| p.payment_date&.year == year } %> payment(s) recorded</div>
  </div>
  <div class="metric-card">
    <div class="metric-label"><%= remaining.positive? ? "Still Owe" : "Overpaid" %></div>
    <div class="metric-value <%= remaining.positive? ? 'text-warning' : 'text-success' %>">$<%= number_with_precision(remaining.abs, precision: 2, delimiter: ",") %></div>
    <div class="metric-note"><%= remaining.positive? ? "Make quarterly payments" : "Credit toward next year" %></div>
  </div>
</div>

<div class="note-box">
  This is an estimate only. Based on <%= summary.table_year %> federal tax brackets for a
  <strong>single filer</strong>, with self-employment tax charged on 92.35% of profit and
  Social Security capped at <%= number_to_currency(summary.social_security_wage_base, precision: 0) %>.
  It does not include state taxes, credits, the QBI deduction, or any filing status other than single.
  <% if summary.estimated_from_other_year? %>
    <br><strong>Note:</strong> <%= year %> figures have not been published here yet, so
    <%= summary.table_year %> brackets are standing in.
  <% end %>
</div>

<h2 class="section-title">Tax Adjustments</h2>
<div class="metric-grid">
  <div class="metric-card">
    <div class="metric-label">Per Diem Deductions</div>
    <div class="metric-value text-success">$<%= number_with_precision(ytd_per_diem, precision: 2, delimiter: ",") %></div>
    <div class="metric-note"><%= @per_diem_entries.count %> entries on file for tax prep</div>
    <div class="record-actions">
      <%= link_to "Manage Per Diem", per_diem_entries_path, class: "btn btn-secondary" %>
      <%= link_to "Add Entry", new_per_diem_entry_path, class: "btn btn-secondary" %>
    </div>
  </div>
  <div class="metric-card">
    <div class="metric-label">Depreciation Deductions</div>
    <div class="metric-value text-info">$<%= number_with_precision(ytd_depreciation, precision: 2, delimiter: ",") %></div>
    <div class="metric-note"><%= @depreciation_assets.count %> assets on file for automatic straight-line depreciation</div>
    <div class="record-actions">
      <%= link_to "Manage Assets", depreciation_assets_path, class: "btn btn-secondary" %>
      <%= link_to "Add Asset", new_depreciation_asset_path, class: "btn btn-secondary" %>
    </div>
  </div>
</div>

<h2 class="section-title">Quarterly Estimated Payments</h2>
<div class="metric-grid is-compact">
  <% quarters.each do |qkey, qinfo| %>
    <% q_paid = TaxPayment.quarter_total(@tax_payments, qkey, year) %>
    <% q_remaining = (quarterly_estimate - q_paid).round(2) %>
    <% is_current = qkey == current_quarter %>
    <div class="metric-card <%= 'is-current' if is_current %>">
      <div class="metric-label"><%= qinfo[:label] %><%= is_current ? " Current" : "" %></div>
      <div class="metric-value">$<%= number_with_precision(quarterly_estimate, precision: 2, delimiter: ",") %></div>
      <div class="metric-note">
        Due: <%= qinfo[:deadline] %><br>
        Paid: $<%= number_with_precision(q_paid, precision: 2, delimiter: ",") %><br>
        <span class="<%= q_remaining.positive? ? 'text-warning' : 'text-success' %>">
          <%= q_remaining.positive? ? "Owe: $#{number_with_precision(q_remaining, precision: 2, delimiter: ',')}" : "Covered" %>
        </span>
      </div>
    </div>
  <% end %>
</div>

<h2 class="section-title">Record a Tax Payment</h2>
<%= form_with url: tax_payments_path, method: :post, class: "form-card" do |form| %>
  <div class="form-grid">
    <div class="two-col">
      <div class="field">
        <%= form.label :payment_date, "Payment Date" %>
        <%= form.date_field :payment_date, value: Date.current, name: "tax_payment[payment_date]" %>
      </div>
      <div class="field">
        <%= form.label :quarter, "Quarter" %>
        <%= form.select :quarter,
          [["Q1 (Jan-Mar)", "Q1"], ["Q2 (Apr-Jun)", "Q2"], ["Q3 (Jul-Sep)", "Q3"], ["Q4 (Oct-Dec)", "Q4"]],
          { selected: current_quarter },
          name: "tax_payment[quarter]" %>
      </div>
    </div>
    <div class="field">
      <%= form.label :amount, "Amount Paid ($)" %>
      <%= form.number_field :amount, step: "0.01", placeholder: quarterly_estimate, name: "tax_payment[amount]" %>
    </div>
    <div class="field">
      <%= form.label :notes, "Notes" %>
      <%= form.text_area :notes, rows: 2, name: "tax_payment[notes]" %>
    </div>
    <div class="action-bar">
      <%= form.submit "Save Payment" %>
    </div>
  </div>
<% end %>

<% if @tax_payments.any? %>
  <h2 class="section-title">Payment History</h2>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Date</th>
          <th>Quarter</th>
          <th class="align-right">Amount</th>
          <th class="align-right">Action</th>
        </tr>
      </thead>
      <tbody>
        <% @tax_payments.order(payment_date: :desc).each do |tp| %>
          <tr>
            <td><%= tp.payment_date %></td>
            <td><%= tp.quarter %></td>
            <td class="align-right text-success"><strong>$<%= number_with_precision(tp.amount, precision: 2) %></strong></td>
            <td class="align-right"><%= link_to "Delete", tp, data: { turbo_method: :delete, turbo_confirm: "Delete this payment?" }, class: "btn-link text-danger" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
