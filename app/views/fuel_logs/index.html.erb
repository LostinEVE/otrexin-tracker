<% content_for :title, "Fuel Log" %>

<div class="page-header">
  <div class="page-title-group">
    <h1>Fuel Log</h1>
    <p class="page-kicker">Track fill-ups, gallons, fuel spend, and MPG trends.</p>
  </div>
  <div class="action-bar">
    <%= link_to "Add Fuel Entry", new_fuel_log_path(truck_id: selected_truck&.id), class: "btn" %>
  </div>
</div>

<%= form_with url: fuel_logs_path, method: :get, local: true, class: "filter-bar" do |f| %>
  <div class="field">
    <%= f.label :truck_id, "Truck" %>
    <%= f.select :truck_id,
      options_from_collection_for_select(@trucks, :id, :display_name, selected_truck&.id),
      { include_blank: "All trucks" } %>
  </div>
  <div class="field">
    <%= f.submit "Filter" %>
  </div>
<% end %>

<div class="metric-grid is-compact">
  <div class="metric-card">
    <div class="metric-label">Total Miles</div>
    <div class="metric-value"><%= number_with_delimiter(@total_miles) %></div>
    <div class="metric-note">Drives cost per mile</div>
  </div>
  <div class="metric-card">
    <div class="metric-label">Overall MPG</div>
    <div class="metric-value"><%= @overall_mpg&.to_s || "-" %></div>
  </div>
  <div class="metric-card">
    <div class="metric-label">Avg MPG (Last 10)</div>
    <div class="metric-value"><%= @avg10&.to_s || "-" %></div>
  </div>
  <div class="metric-card">
    <div class="metric-label">Gallons MTD</div>
    <div class="metric-value"><%= number_with_precision(@total_gallons_mtd, precision: 1) %></div>
  </div>
  <div class="metric-card">
    <div class="metric-label">Total Fuel Cost</div>
    <div class="metric-value text-danger"><%= money(@total_fuel_cost) %></div>
    <div class="metric-note">Reference only</div>
  </div>
</div>

<div class="note-box">
  Odometer readings here are where <strong>every mile</strong> in your P&amp;L and cost per
  mile comes from, so keep them accurate. The fuel cost above is <strong>not</strong>
  counted as money spent — record that as an expense under <strong>Fuel</strong> so it is
  only counted once.
  <%= link_to "Add the expense", new_expense_path(category: "fuel", truck_id: selected_truck&.id), class: "btn-link" %>
</div>

<% if @excluded_mileage_interval_count.to_i.positive? %>
  <div class="note-box is-warning">
    <strong><%= number_with_delimiter(@uncounted_miles) %> miles are missing from your total.</strong>
    Your odometer moved <%= number_with_delimiter(@tracked_span) %> miles overall, but
    <%= pluralize(@excluded_mileage_interval_count, "gap") %> between fill-ups did not look like
    real driving, so only <%= number_with_delimiter(@total_miles) %> could be counted. A gap has
    to move forward and stay under <%= number_with_delimiter(FuelLog::MAX_INTERVAL_MILES) %>
    miles to count — check for a mistyped odometer or a fill-up you did not log. Until this is
    fixed your cost per mile reads higher than it really is.
  </div>
<% elsif @total_miles.to_i.positive? %>
  <div class="note-box">
    Odometer moved <%= number_with_delimiter(@tracked_span) %> miles across these entries and
    all <%= number_with_delimiter(@total_miles) %> counted toward your cost per mile.
  </div>
<% end %>

<% if @excluded_mpg_interval_count.to_i.positive? %>
  <div class="note-box">
    MPG is ignoring <%= pluralize(@excluded_mpg_interval_count, "fill-up") %> that could not
    produce a believable figure — over <%= number_with_delimiter(FuelLog::MAX_INTERVAL_MILES) %>
    miles on one tank, or above <%= FuelLog::MAX_REASONABLE_MPG.to_i %> MPG.
  </div>
<% end %>

<div id="fuel_logs" class="record-list">
  <% if @fuel_logs.any? %>
    <% @fuel_logs.each do |fuel_log| %>
      <%= render fuel_log %>
    <% end %>
  <% else %>
    <div class="empty-state">No fuel entries yet.</div>
  <% end %>
</div>
