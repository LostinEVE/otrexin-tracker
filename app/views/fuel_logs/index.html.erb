<% content_for :title, "Fuel Log" %>

<div class="page-header">
  <div class="page-title-group">
    <h1>Fuel Log</h1>
    <p class="page-kicker">Track fill-ups, gallons, fuel spend, and MPG trends.</p>
  </div>
  <div class="action-bar">
    <%= link_to "Add Fuel Entry", new_fuel_log_path(truck_id: selected_truck&.id), class: "btn" %>
  </div>
</div>

<%= form_with url: fuel_logs_path, method: :get, local: true, class: "filter-bar" do |f| %>
  <div class="field">
    <%= f.label :truck_id, "Truck" %>
    <%= f.select :truck_id,
      options_from_collection_for_select(@trucks, :id, :display_name, selected_truck&.id),
      { include_blank: "All trucks" } %>
  </div>
  <div class="field">
    <%= f.submit "Filter" %>
  </div>
<% end %>

<div class="metric-grid is-compact">
  <div class="metric-card">
    <div class="metric-label">Overall MPG</div>
    <div class="metric-value"><%= @overall_mpg&.to_s || "-" %></div>
  </div>
  <div class="metric-card">
    <div class="metric-label">Avg MPG (Last 10)</div>
    <div class="metric-value"><%= @avg10&.to_s || "-" %></div>
  </div>
  <div class="metric-card">
    <div class="metric-label">Gallons MTD</div>
    <div class="metric-value"><%= number_with_precision(@total_gallons_mtd, precision: 1) %></div>
  </div>
  <div class="metric-card">
    <div class="metric-label">Total Fuel Cost</div>
    <div class="metric-value text-danger">$<%= number_with_precision(@total_fuel_cost, precision: 2) %></div>
  </div>
</div>

<% if @excluded_mpg_interval_count.to_i.positive? %>
  <div class="note-box">
    MPG is ignoring <%= pluralize(@excluded_mpg_interval_count, "odometer interval") %> that look unrealistic, such as repair/reset jumps over <%= number_with_delimiter(FuelLog::MAX_MPG_INTERVAL_MILES) %> miles or above <%= FuelLog::MAX_REASONABLE_MPG.to_i %> MPG.
  </div>
<% end %>

<div id="fuel_logs" class="record-list">
  <% if @fuel_logs.any? %>
    <% @fuel_logs.each do |fuel_log| %>
      <%= render fuel_log %>
    <% end %>
  <% else %>
    <div class="empty-state">No fuel entries yet.</div>
  <% end %>
</div>
