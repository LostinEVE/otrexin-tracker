<% mpg = fuel_log.mpg_since_last_fill %>
<% miles = fuel_log.miles_since_last_fill %>
<% total_cost = fuel_log.total_cost.present? ? "$#{number_with_precision(fuel_log.total_cost, precision: 2)}" : "-" %>
<% price_per_gallon = fuel_log.price_per_gallon.present? ? "$#{fuel_log.price_per_gallon}" : "-" %>

<div id="<%= dom_id fuel_log %>" class="record-card">
  <div class="record-main">
    <div>
      <h3 class="record-title"><%= fuel_log.fuel_date %> - <%= fuel_log.station.presence || fuel_log.location %></h3>
      <div class="record-subtitle"><%= fuel_log.truck.display_name %> - <%= fuel_log.location.presence || "No location" %></div>
    </div>
    <div class="record-amount text-danger"><%= total_cost %></div>
  </div>

  <div class="record-meta-grid">
    <div class="meta-item">
      <div class="meta-label">Odometer</div>
      <div class="meta-value"><%= number_with_delimiter(fuel_log.odometer) %></div>
    </div>
    <div class="meta-item">
      <div class="meta-label">Gallons</div>
      <div class="meta-value"><%= fuel_log.gallons || "-" %></div>
    </div>
    <div class="meta-item">
      <div class="meta-label">Price / Gal</div>
      <div class="meta-value"><%= price_per_gallon %></div>
    </div>
    <div class="meta-item">
      <div class="meta-label">Miles This Fill</div>
      <div class="meta-value"><%= miles&.to_s || "-" %></div>
    </div>
    <div class="meta-item">
      <div class="meta-label">MPG This Fill</div>
      <div class="meta-value <%= mpg ? (mpg >= 6 ? 'text-success' : 'text-warning') : 'text-muted' %>"><%= mpg&.to_s || "-" %></div>
    </div>
  </div>

  <% if fuel_log.notes.present? %>
    <p class="record-note"><%= fuel_log.notes %></p>
  <% end %>

  <div class="record-actions">
    <%= link_to "View", fuel_log, class: "btn btn-secondary" %>
    <%= link_to "Edit", edit_fuel_log_path(fuel_log), class: "btn btn-secondary" %>
    <%= link_to "Delete", fuel_log, data: { turbo_method: :delete, turbo_confirm: "Delete this entry?" }, class: "btn btn-danger" %>
  </div>
</div>
