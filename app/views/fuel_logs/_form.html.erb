<%= form_with(model: fuel_log, class: "form-card") do |form| %>
  <% if fuel_log.errors.any? %>
    <div class="form-errors">
      <h3><%= pluralize(fuel_log.errors.count, "error") %> stopped this entry from saving:</h3>
      <ul>
        <% fuel_log.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-grid">
    <div class="two-col">
      <div class="field">
        <%= form.label :truck_id, "Truck" %>
        <%= form.collection_select :truck_id, @trucks, :id, :display_name, { prompt: "Select a truck" } %>
      </div>
      <div class="field">
        <%= form.label :fuel_date, "Date" %>
        <%= form.date_field :fuel_date %>
      </div>
    </div>

    <div class="field">
      <%= form.label :odometer, "Odometer Reading" %>
      <%= form.number_field :odometer, placeholder: "123456", id: "fuel_odometer", required: true %>
    </div>

    <div class="two-col">
      <div class="field">
        <%= form.label :gallons, "Gallons" %>
        <%= form.number_field :gallons, step: "0.01", placeholder: "150.50", id: "fuel_gallons", oninput: "calcTotal()" %>
      </div>
      <div class="field">
        <%= form.label :price_per_gallon, "Price per Gallon ($)" %>
        <%= form.number_field :price_per_gallon, step: "0.001", placeholder: "3.450", id: "fuel_ppg", oninput: "calcTotal()" %>
      </div>
    </div>

    <div class="field">
      <%= form.label :total_cost, "Total Cost ($)" %>
      <%= form.number_field :total_cost, step: "0.01", placeholder: "0.00", id: "fuel_total" %>
      <p class="field-hint">For your records. Log the money as an expense under Fuel to have it count in your P&amp;L.</p>
    </div>

    <div class="two-col">
      <div class="field">
        <%= form.label :location, "Location (City, State)" %>
        <%= form.text_field :location, placeholder: "Memphis, TN" %>
      </div>
      <div class="field">
        <%= form.label :station, "Station Name" %>
        <%= form.text_field :station, placeholder: "Pilot, Love's, TA..." %>
      </div>
    </div>

    <div class="field">
      <%= form.label :notes, "Notes" %>
      <%= form.text_area :notes, rows: 2 %>
    </div>

    <div class="action-bar">
      <%= form.submit "Save Fuel Entry" %>
    </div>
  </div>
<% end %>

<script>
  function calcTotal() {
    const g = parseFloat(document.getElementById("fuel_gallons")?.value) || 0;
    const p = parseFloat(document.getElementById("fuel_ppg")?.value) || 0;
    const t = document.getElementById("fuel_total");
    if (t) t.value = (g * p).toFixed(2);
  }
</script>
