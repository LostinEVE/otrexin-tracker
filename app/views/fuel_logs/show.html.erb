<% content_for :title, "Fuel Entry" %>

<div class="page-header">
  <div class="page-title-group">
    <h1>Fuel Entry</h1>
  </div>
</div>

<%= render @fuel_log %>

<div class="page-footer-actions">
  <%= link_to "Edit Fuel Entry", edit_fuel_log_path(@fuel_log), class: "btn btn-secondary" %>
  <%= link_to "Back to Fuel Log", fuel_logs_path, class: "btn btn-secondary" %>
  <%= button_to "Delete Fuel Entry", @fuel_log, method: :delete, class: "btn btn-danger" %>
</div>
