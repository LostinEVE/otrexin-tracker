<% content_for :title, "Import Results" %>

<% imported = @outcomes.select(&:imported?)
   skipped  = @outcomes.select(&:skipped?)
   failed   = @outcomes.select(&:failed?)
   conflicted = @outcomes.select(&:conflict?)
   revenue  = imported.sum { |o| o.settlement.truck_revenue }
   deducted = imported.sum { |o| o.settlement.total_deductions } %>

<div class="page-header">
  <div class="page-title-group">
    <h1>Import Results</h1>
    <p class="page-kicker"><%= pluralize(@outcomes.size, "statement") %> read.</p>
  </div>
  <div class="action-bar">
    <%= link_to "Recorded Settlements", settlements_path, class: "btn" %>
    <%= link_to "Import More", new_settlement_import_path, class: "btn btn-secondary" %>
  </div>
</div>

<% if imported.empty? %>
  <div class="note-box is-warning">
    <strong>Nothing was imported.</strong> No settlement was recorded, so your books are unchanged.
    The rows below say why for each file. The usual causes, in order:
    <br><br>
    <strong>1.</strong> The PDFs are stored in OneDrive but not on this device, so they uploaded as
    empty. In File Explorer, right-click the <em>settlements</em> folder, choose
    <em>"Always keep on this device"</em>, wait for green checkmarks, then import again.
    <br>
    <strong>2.</strong> The statements are already on your books by hand — those show as
    <em>Already on books</em> and are held back on purpose.
    <br>
    <strong>3.</strong> The statement is a format the reader does not know yet, shown as
    <em>Not read</em> with the amount it could not account for.
  </div>
<% end %>

<div class="metric-grid is-compact">
  <div class="metric-card">
    <div class="metric-label">Imported</div>
    <div class="metric-value text-success"><%= imported.size %></div>
  </div>
  <div class="metric-card">
    <div class="metric-label">Revenue Added</div>
    <div class="metric-value text-success"><%= money(revenue) %></div>
  </div>
  <div class="metric-card">
    <div class="metric-label">Deductions Recorded</div>
    <div class="metric-value text-danger"><%= money(deducted) %></div>
  </div>
  <div class="metric-card">
    <div class="metric-label">Skipped / Failed</div>
    <div class="metric-value <%= failed.any? ? "text-warning" : "" %>"><%= skipped.size %> / <%= failed.size %></div>
  </div>
</div>

<% if conflicted.any? %>
  <div class="note-box is-warning">
    <strong><%= pluralize(conflicted.size, "statement") %> already looks to be on your books</strong>
    and was <strong>not</strong> imported, so nothing has been counted twice. These are dates where
    expenses matching the settlement's deductions already exist without a settlement behind them —
    almost certainly the weeks you entered by hand.
    <br><br>
    Import these again with <strong>"Match it up"</strong> selected. That keeps every row you typed,
    links them to the settlement so they are never counted twice, records the revenue that is
    currently missing for these weeks, and fixes each row's category from the statement. Nothing is
    deleted.
  </div>
<% end %>

<% if @overlapping_invoices.present? && @overlapping_invoices.any? %>
  <div class="note-box is-warning">
    <strong><%= pluralize(@overlapping_invoices.count, "paid invoice") %></strong> sits in the same
    date range as the statements just imported, totalling
    <strong><%= money(@overlapping_invoices.sum(:amount)) %></strong>. Revenue counts settlements and
    invoices together, so if those invoices describe the same loads your income is now counted twice.
    A driver leased to a carrier is normally paid on settlements only.
    <%= link_to "Review invoices", invoices_path, class: "btn-link" %>
  </div>
<% end %>

<% if @skipped_empty.present? %>
  <div class="note-box is-warning">
    <strong><%= pluralize(@skipped_empty.size, "file") %> arrived empty</strong> and was skipped:
    <%= @skipped_empty.to_sentence %>. A file stored in OneDrive or iCloud but not downloaded to this
    device uploads as nothing. Right-click the folder, choose "Always keep on this device", wait for it
    to sync, then import again.
  </div>
<% end %>

<% if failed.any? %>
  <div class="note-box is-warning">
    <strong><%= pluralize(failed.size, "statement") %> could not be read to the cent</strong> and was
    left alone. Nothing partial was imported. Record these by hand from a template, or send me the
    figures and I will teach the reader the format.
  </div>
<% end %>

<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>Status</th>
        <th>Date</th>
        <th class="align-right">Revenue</th>
        <th class="align-right">Deductions</th>
        <th class="align-right">Fuel Advance</th>
        <th>Detail</th>
      </tr>
    </thead>
    <tbody>
      <% @outcomes.each do |outcome| %>
        <tr>
          <td>
            <% if outcome.imported? %>
              <span class="badge badge-success">Imported</span>
            <% elsif outcome.skipped? %>
              <span class="badge badge-neutral">Already imported</span>
            <% elsif outcome.conflict? %>
              <span class="badge badge-warning">Already on books</span>
            <% else %>
              <span class="badge badge-warning">Not read</span>
            <% end %>
          </td>
          <td><%= outcome.settlement&.statement_date || outcome.result&.statement_date || "-" %></td>
          <td class="align-right"><%= outcome.settlement ? money(outcome.settlement.truck_revenue) : "-" %></td>
          <td class="align-right"><%= outcome.settlement ? money(outcome.settlement.total_deductions) : "-" %></td>
          <td class="align-right text-muted"><%= outcome.settlement ? money(outcome.settlement.fuel_advance) : "-" %></td>
          <td class="text-muted"><%= outcome.message %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
