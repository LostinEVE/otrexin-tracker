<% content_for :title, "Customer Analysis" %>

<div class="page-header">
  <div class="page-title-group">
    <h1>Customer Analysis</h1>
    <p class="page-kicker">Automatically summarized from invoice history.</p>
  </div>
</div>

<% if @customers.empty? %>
  <div class="empty-state">No invoices yet. Customer analysis will appear here once invoices are added.</div>
<% else %>
  <div class="metric-grid">
    <div class="metric-card">
      <div class="metric-label">Total Customers</div>
      <div class="metric-value"><%= @customers.size %></div>
    </div>
    <div class="metric-card">
      <div class="metric-label">Top Customer</div>
      <div class="metric-value"><%= @top_customer[:name] %></div>
      <div class="metric-note text-success">$<%= number_with_precision(@top_customer[:total_revenue], precision: 2, delimiter: ",") %> revenue</div>
    </div>
    <div class="metric-card">
      <div class="metric-label">Avg Customer Value</div>
      <div class="metric-value">$<%= number_with_precision(@avg_customer_value, precision: 2, delimiter: ",") %></div>
    </div>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Customer</th>
          <th class="align-center">Invoices</th>
          <th class="align-right">Total Revenue</th>
          <th class="align-right">Avg Invoice</th>
          <th class="align-center">Unpaid</th>
          <th class="align-center">Payment Rate</th>
        </tr>
      </thead>
      <tbody>
        <% @customers.each do |customer| %>
          <% rate = customer[:payment_rate] %>
          <tr>
            <td><strong><%= customer[:name] %></strong></td>
            <td class="align-center"><%= customer[:invoice_count] %></td>
            <td class="align-right text-success"><strong>$<%= number_with_precision(customer[:total_revenue], precision: 2, delimiter: ",") %></strong></td>
            <td class="align-right">$<%= number_with_precision(customer[:avg_invoice], precision: 2) %></td>
            <td class="align-center <%= customer[:unpaid_count].positive? ? 'text-warning' : '' %>">
              <strong><%= customer[:unpaid_count].positive? ? customer[:unpaid_count] : "-" %></strong>
            </td>
            <td class="align-center">
              <span class="badge <%= rate == 100 ? 'badge-success' : rate >= 50 ? 'badge-warning' : 'badge-danger' %>"><%= rate %>% paid</span>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
