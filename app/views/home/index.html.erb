<% content_for :title, "Dashboard" %>

<div class="page-header">
  <div class="page-title-group">
    <h1>Dashboard</h1>
    <p class="page-kicker">A current snapshot of revenue, expenses, miles, and unpaid invoices.</p>
  </div>
</div>

<%= form_with url: root_path, method: :get, local: true, class: "filter-bar" do |f| %>
  <div class="field">
    <%= f.label :truck_id, "Truck" %>
    <%= f.select :truck_id,
      options_from_collection_for_select(current_trucks, :id, :display_name, selected_truck&.id),
      { include_blank: "All trucks" } %>
  </div>
  <div class="field">
    <%= f.submit "Filter" %>
  </div>
<% end %>

<% unless @year.reconciled? %>
  <div class="note-box is-warning">
    <strong><%= money(@year.unreconciled_total) %></strong>
    more has been logged in fuel and maintenance costs this year than you have recorded as
    expenses, so that money is not in your profit, tax, or cost-per-mile figures.
    <%= link_to "Review on the P&L", reports_profit_loss_path, class: "btn-link" %>
  </div>
<% end %>

<h2 class="section-title">Revenue</h2>
<div class="metric-grid">
  <div class="metric-card">
    <div class="metric-label">Unpaid Invoices</div>
    <div class="metric-value text-warning"><%= money(@unpaid_total) %></div>
  </div>
  <div class="metric-card">
    <div class="metric-label">Collected This Month</div>
    <div class="metric-value text-success"><%= money(@month.revenue) %></div>
  </div>
  <div class="metric-card">
    <div class="metric-label">YTD Revenue</div>
    <div class="metric-value text-success"><%= money(@year.revenue) %></div>
  </div>
</div>

<h2 class="section-title">Expenses</h2>
<div class="metric-grid">
  <div class="metric-card">
    <div class="metric-label">Expenses This Month</div>
    <div class="metric-value text-danger"><%= money(@month.expense_total) %></div>
  </div>
  <div class="metric-card">
    <div class="metric-label">YTD Expenses</div>
    <div class="metric-value text-danger"><%= money(@year.expense_total) %></div>
  </div>
  <div class="metric-card">
    <div class="metric-label">YTD Net Profit</div>
    <div class="metric-value <%= profit_class(@year.net_profit) %>"><%= money(@year.net_profit) %></div>
  </div>
</div>

<% if @month.expense_by_category.any? %>
  <section class="panel">
    <div class="panel-header">
      <h3 class="panel-title">This Month by Category</h3>
    </div>
    <div class="table-wrap">
      <table>
        <tbody>
          <% @month.expense_by_category.each do |category, amount| %>
            <tr>
              <td><%= expense_category_label(category) %></td>
              <td class="align-right text-danger"><strong><%= money(amount) %></strong></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
<% end %>

<h2 class="section-title">Performance (Year to Date)</h2>
<div class="metric-grid is-compact">
  <div class="metric-card">
    <div class="metric-label">Total Miles</div>
    <div class="metric-value"><%= number_with_delimiter(@year.total_miles) %></div>
    <div class="metric-note">From fuel log odometer</div>
  </div>
  <div class="metric-card">
    <div class="metric-label">Revenue / Mile</div>
    <div class="metric-value text-success"><%= per_mile(@year.revenue_per_mile) %></div>
  </div>
  <div class="metric-card">
    <div class="metric-label">Cost / Mile</div>
    <div class="metric-value text-danger"><%= per_mile(@year.cost_per_mile) %></div>
    <div class="metric-note">All expenses ÷ miles</div>
  </div>
  <div class="metric-card">
    <div class="metric-label">Overall MPG</div>
    <div class="metric-value"><%= @overall_mpg || "-" %></div>
  </div>
</div>

<% if @recent_unpaid.any? %>
  <h2 class="section-title">Outstanding Invoices</h2>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Invoice #</th>
          <th>Date</th>
          <th>Customer</th>
          <th class="align-right">Amount</th>
          <th class="align-right">Action</th>
        </tr>
      </thead>
      <tbody>
        <% @recent_unpaid.each do |inv| %>
          <tr>
            <td><strong><%= inv.invoice_number %></strong></td>
            <td><%= inv.invoice_date %></td>
            <td><%= inv.customer_name %></td>
            <td class="align-right text-warning"><strong><%= money(inv.amount) %></strong></td>
            <td class="align-right"><%= link_to "Edit", edit_invoice_path(inv), class: "btn-link" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
