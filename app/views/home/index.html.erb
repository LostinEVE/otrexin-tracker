<% content_for :title, "Dashboard" %>

<% category_labels = {
  "fuel" => "Fuel",
  "maintenance" => "Maintenance & Repairs",
  "tolls" => "Tolls & Parking",
  "food" => "Food & Meals",
  "insurance" => "Insurance",
  "permits" => "Permits & Licenses",
  "truck_payment" => "Truck Payment / Lease",
  "supplies" => "Supplies",
  "drivers_pay" => "Drivers Pay",
  "truck_wash_hopper_washout" => "Truck Wash / Hopper Washout",
  "other" => "Other"
} %>

<div class="page-header">
  <div class="page-title-group">
    <h1>Dashboard</h1>
    <p class="page-kicker">A current snapshot of revenue, expenses, mileage, and unpaid invoices.</p>
  </div>
</div>

<%= form_with url: root_path, method: :get, local: true, class: "filter-bar" do |f| %>
  <div class="field">
    <%= f.label :truck_id, "Truck" %>
    <%= f.select :truck_id,
      options_from_collection_for_select(current_trucks, :id, :display_name, selected_truck&.id),
      { include_blank: "All trucks" } %>
  </div>
  <div class="field">
    <%= f.submit "Filter" %>
  </div>
<% end %>

<h2 class="section-title">Revenue</h2>
<div class="metric-grid">
  <div class="metric-card">
    <div class="metric-label">Unpaid Invoices</div>
    <div class="metric-value text-warning">$<%= number_with_precision(@unpaid_total, precision: 2, delimiter: ",") %></div>
  </div>
  <div class="metric-card">
    <div class="metric-label">Collected This Month</div>
    <div class="metric-value text-success">$<%= number_with_precision(@paid_mtd, precision: 2, delimiter: ",") %></div>
  </div>
  <div class="metric-card">
    <div class="metric-label">YTD Revenue</div>
    <div class="metric-value text-success">$<%= number_with_precision(@ytd_revenue, precision: 2, delimiter: ",") %></div>
  </div>
</div>

<h2 class="section-title">Expenses</h2>
<div class="metric-grid">
  <div class="metric-card">
    <div class="metric-label">Expenses This Month</div>
    <div class="metric-value text-danger">$<%= number_with_precision(@expenses_mtd, precision: 2, delimiter: ",") %></div>
  </div>
  <div class="metric-card">
    <div class="metric-label">YTD Expenses</div>
    <div class="metric-value text-danger">$<%= number_with_precision(@ytd_expenses, precision: 2, delimiter: ",") %></div>
  </div>
</div>

<% if @expenses_by_category_mtd.any? %>
  <section class="panel">
    <div class="panel-header">
      <h3 class="panel-title">This Month by Category</h3>
    </div>
    <div class="table-wrap">
      <table>
        <tbody>
          <% @expenses_by_category_mtd.each do |cat, amt| %>
            <tr>
              <td><%= category_labels[cat] || cat.to_s.humanize %></td>
              <td class="align-right text-danger"><strong>$<%= number_with_precision(amt, precision: 2, delimiter: ",") %></strong></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
<% end %>

<h2 class="section-title">Performance</h2>
<div class="metric-grid is-compact">
  <div class="metric-card">
    <div class="metric-label">Total Miles</div>
    <div class="metric-value"><%= number_with_precision(@total_miles, precision: 1, delimiter: ",") %></div>
  </div>
  <div class="metric-card">
    <div class="metric-label">Revenue / Mile</div>
    <div class="metric-value"><%= @rpm ? "$#{@rpm}" : "-" %></div>
  </div>
  <div class="metric-card">
    <div class="metric-label">Cost / Mile</div>
    <div class="metric-value"><%= @cpm ? "$#{@cpm}" : "-" %></div>
    <div class="metric-note">From mileage entries</div>
  </div>
  <div class="metric-card">
    <div class="metric-label">Overall MPG</div>
    <div class="metric-value"><%= @overall_mpg || "-" %></div>
  </div>
</div>

<% if @recent_unpaid.any? %>
  <h2 class="section-title">Outstanding Invoices</h2>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Invoice #</th>
          <th>Date</th>
          <th>Customer</th>
          <th class="align-right">Amount</th>
          <th class="align-right">Action</th>
        </tr>
      </thead>
      <tbody>
        <% @recent_unpaid.each do |inv| %>
          <tr>
            <td><strong><%= inv.invoice_number %></strong></td>
            <td><%= inv.invoice_date %></td>
            <td><%= inv.customer_name %></td>
            <td class="align-right text-warning"><strong>$<%= number_with_precision(inv.amount, precision: 2) %></strong></td>
            <td class="align-right"><%= link_to "Edit", edit_invoice_path(inv), class: "btn-link" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
