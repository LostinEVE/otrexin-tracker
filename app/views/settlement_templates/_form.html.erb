<%= form_with(model: settlement_template, class: "form-card") do |form| %>
  <% if settlement_template.errors.any? %>
    <div class="form-errors">
      <h3><%= pluralize(settlement_template.errors.count, "error") %> stopped this template from saving:</h3>
      <ul>
        <% settlement_template.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-grid">
    <div class="two-col">
      <div class="field">
        <%= form.label :name, "Template Name" %>
        <%= form.text_field :name, placeholder: "Kaplan weekly settlement" %>
      </div>
      <div class="field">
        <%= form.label :vendor, "Vendor" %>
        <%= form.text_field :vendor, placeholder: "Kaplan" %>
        <p class="field-hint">Used as the vendor on every expense this template creates.</p>
      </div>
    </div>

    <div class="field">
      <%= form.label :truck_id, "Truck" %>
      <%= form.select :truck_id,
            options_from_collection_for_select(@trucks, :id, :display_name, settlement_template.truck_id),
            { include_blank: "Use my default truck" } %>
    </div>

    <h2 class="section-title">Deduction Lines</h2>
    <p class="field-hint">
      One row per line on your settlement statement. Amounts here are defaults — you can adjust any
      of them each week before recording. Set a total only on lines that pay something down, like
      plates, a permit, or an equipment loan.
    </p>

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Label</th>
            <th>Category</th>
            <th class="align-right">Default Amount</th>
            <th class="align-right">Total to Pay Off</th>
            <th class="align-center">On</th>
            <th class="align-center">Remove</th>
          </tr>
        </thead>
        <tbody>
          <%= form.fields_for :lines do |line_form| %>
            <tr>
              <td><%= line_form.text_field :label, placeholder: "Occupational Accident Ins" %></td>
              <td>
                <%= line_form.select :category,
                      Expense::CATEGORIES.map { |value, label| [ label, value ] },
                      { prompt: "Select" } %>
              </td>
              <td><%= line_form.number_field :amount, step: "0.01", placeholder: "0.00" %></td>
              <td><%= line_form.number_field :balance_target, step: "0.01", placeholder: "Optional" %></td>
              <td class="align-center"><%= line_form.check_box :active %></td>
              <td class="align-center">
                <% if line_form.object.persisted? %>
                  <%= line_form.check_box :_destroy %>
                <% end %>
              </td>
              <%= line_form.hidden_field :position %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="action-bar">
      <%= form.submit settlement_template.persisted? ? "Update Template" : "Save Template" %>
      <%= link_to "Cancel", settlement_templates_path, class: "btn btn-secondary" %>
    </div>
  </div>
<% end %>
