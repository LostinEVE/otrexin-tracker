<% content_for :title, "Profit & Loss" %>

<div class="page-header">
  <div class="page-title-group">
    <h1>Profit &amp; Loss Statement</h1>
    <p class="page-kicker">Bank and tax-ready summary for the selected truck and date range.</p>
  </div>
</div>

<%= form_with url: reports_profit_loss_path, method: :get, local: true, class: "filter-bar is-wide" do |f| %>
  <div class="field">
    <%= f.label :truck_id, "Truck" %>
    <%= f.select :truck_id,
      options_from_collection_for_select(current_trucks, :id, :display_name, selected_truck&.id),
      { include_blank: "All trucks" } %>
  </div>
  <div class="field">
    <%= f.label :start_date, "Start Date" %>
    <%= f.date_field :start_date, value: @start_date %>
  </div>
  <div class="field">
    <%= f.label :end_date, "End Date" %>
    <%= f.date_field :end_date, value: @end_date %>
  </div>
  <div class="field">
    <%= f.submit "Run Report" %>
  </div>
<% end %>

<div class="statement-caption">
  <strong><%= selected_truck&.display_name || "All trucks" %></strong>
  &middot; <%= @start_date.strftime("%b %-d, %Y") %> through <%= @end_date.strftime("%b %-d, %Y") %>
</div>

<div class="action-bar">
  <%= link_to "Export CSV", reports_profit_loss_path(format: :csv, truck_id: selected_truck&.id, start_date: @start_date, end_date: @end_date), class: "btn btn-secondary" %>
  <a href="#" onclick="window.print();return false;" class="btn btn-secondary">Print / Save PDF</a>
</div>

<div class="metric-grid">
  <div class="metric-card">
    <div class="metric-label">Revenue</div>
    <div class="metric-value text-success"><%= money(@summary.revenue) %></div>
    <div class="metric-note">
      <% if @summary.settlement_revenue.positive? && @summary.invoice_revenue.positive? %>
        Settlements and paid invoices
      <% elsif @summary.settlement_revenue.positive? %>
        Carrier settlements
      <% else %>
        Paid invoices
      <% end %>
    </div>
  </div>
  <div class="metric-card">
    <div class="metric-label">Operating Expenses</div>
    <div class="metric-value text-danger"><%= money(@summary.expense_total) %></div>
    <div class="metric-note">All logged expenses</div>
  </div>
  <div class="metric-card">
    <div class="metric-label">Net Profit</div>
    <div class="metric-value <%= profit_class(@summary.net_profit) %>"><%= money(@summary.net_profit) %></div>
    <div class="metric-note">
      <% if @summary.revenue.positive? %>
        <%= number_to_percentage(@summary.net_profit / @summary.revenue * 100, precision: 1) %> margin
      <% else %>
        No revenue in period
      <% end %>
    </div>
  </div>
  <div class="metric-card">
    <div class="metric-label">Taxable Profit Est.</div>
    <div class="metric-value <%= profit_class(@summary.taxable_profit_estimate) %>"><%= money(@summary.taxable_profit_estimate) %></div>
    <div class="metric-note">After per diem &amp; depreciation</div>
  </div>
</div>


<% if @summary.carrier_ytd_revenue.present? %>
  <% diff = @summary.ytd_difference %>
  <div class="note-box <%= diff.abs < 1 ? "" : "is-warning" %>">
    <strong>Checked against your carrier's own figure.</strong>
    Your <%= @summary.latest_ytd_statement.statement_date %> statement says
    <strong><%= money(@summary.carrier_ytd_revenue) %></strong> of 1099 revenue for the year
    <% if @summary.latest_ytd_statement.ytd_load_count %>
      across <%= @summary.latest_ytd_statement.ytd_load_count %> loads<% end %>.
    Your books show <strong><%= money(@summary.revenue_to_compare) %></strong>.
    <% if diff.abs < 1 %>
      They agree — that is the number the IRS will see.
    <% elsif diff.negative? %>
      You are <strong><%= money(diff.abs) %></strong> short, which usually means a statement was
      never imported. Anything missing is income the 1099 will report but your books do not.
    <% else %>
      You are <strong><%= money(diff) %></strong> over, which usually means the same income is
      recorded twice — most often loads entered as invoices as well as settlements.
      <%= link_to "Check invoices", invoices_path, class: "btn-link" %>
    <% end %>
  </div>
<% end %>

<h2 class="section-title">Per Mile</h2>
<div class="metric-grid is-compact">
  <div class="metric-card">
    <div class="metric-label">Total Miles</div>
    <div class="metric-value"><%= number_with_delimiter(@summary.total_miles) %></div>
    <div class="metric-note">From fuel log odometer</div>
  </div>
  <div class="metric-card">
    <div class="metric-label">Revenue / Mile</div>
    <div class="metric-value text-success"><%= per_mile(@summary.revenue_per_mile) %></div>
  </div>
  <div class="metric-card">
    <div class="metric-label">Cost / Mile</div>
    <div class="metric-value text-danger"><%= per_mile(@summary.cost_per_mile) %></div>
  </div>
  <div class="metric-card">
    <div class="metric-label">Profit / Mile</div>
    <div class="metric-value <%= @summary.profit_per_mile ? profit_class(@summary.profit_per_mile) : "" %>"><%= per_mile(@summary.profit_per_mile) %></div>
  </div>
</div>

<% if @summary.total_miles.zero? %>
  <div class="note-box">
    No miles could be derived for this period. Cost per mile needs at least two fuel
    entries for the same truck so the odometer difference between them can be measured.
  </div>
<% end %>

<h2 class="section-title">Statement</h2>
<section class="panel">
  <div class="table-wrap">
    <table class="statement">
      <tbody>
        <tr class="statement-section">
          <td>Revenue</td>
          <td class="align-right"></td>
        </tr>
        <% if @summary.settlement_revenue.positive? %>
          <tr>
            <td class="statement-item">Carrier settlements</td>
            <td class="align-right"><%= money(@summary.settlement_revenue) %></td>
          </tr>
          <% if @summary.fuel_surcharge_total.positive? %>
            <tr>
              <td class="statement-item text-muted">&mdash; of which fuel surcharge</td>
              <td class="align-right text-muted"><%= money(@summary.fuel_surcharge_total) %></td>
            </tr>
          <% end %>
        <% end %>
        <tr>
          <td class="statement-item">Paid invoices</td>
          <td class="align-right"><%= money(@summary.invoice_revenue) %></td>
        </tr>
        <tr class="statement-total">
          <td>Total Revenue</td>
          <td class="align-right text-success"><%= money(@summary.revenue) %></td>
        </tr>

        <tr class="statement-section">
          <td>Operating Expenses</td>
          <td class="align-right"></td>
        </tr>
        <% if @summary.expense_by_category.any? %>
          <% @summary.expense_by_category.each do |category, amount| %>
            <tr>
              <td class="statement-item"><%= expense_category_label(category) %></td>
              <td class="align-right"><%= money(amount) %></td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td class="statement-item text-muted">No expenses recorded in this period</td>
            <td class="align-right"><%= money(0) %></td>
          </tr>
        <% end %>
        <tr class="statement-total">
          <td>Total Operating Expenses</td>
          <td class="align-right text-danger"><%= money(@summary.expense_total) %></td>
        </tr>

        <tr class="statement-total is-emphasis">
          <td>Net Profit</td>
          <td class="align-right <%= profit_class(@summary.net_profit) %>"><%= money(@summary.net_profit) %></td>
        </tr>

        <tr class="statement-section">
          <td>Tax Adjustments</td>
          <td class="align-right"></td>
        </tr>
        <tr>
          <td class="statement-item">Per diem deductions</td>
          <td class="align-right"><%= money(@summary.per_diem_total) %></td>
        </tr>
        <tr>
          <td class="statement-item">Depreciation deductions</td>
          <td class="align-right"><%= money(@summary.depreciation_total) %></td>
        </tr>
        <tr class="statement-total">
          <td>Total Tax Adjustments</td>
          <td class="align-right text-info"><%= money(@summary.tax_adjustment_total) %></td>
        </tr>

        <tr class="statement-total is-emphasis">
          <td>Taxable Profit Estimate</td>
          <td class="align-right <%= profit_class(@summary.taxable_profit_estimate) %>"><%= money(@summary.taxable_profit_estimate) %></td>
        </tr>

        <% if @summary.escrow_total.positive? || @summary.escrow_balance.positive? %>
          <tr class="statement-section">
            <td>Not an Expense</td>
            <td class="align-right"></td>
          </tr>
          <tr>
            <td class="statement-item">Escrow withheld this period</td>
            <td class="align-right"><%= money(@summary.escrow_total) %></td>
          </tr>
          <tr>
            <td class="statement-item">Escrow balance held to date</td>
            <td class="align-right"><strong><%= money(@summary.escrow_balance) %></strong></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>

<% if @summary.escrow_balance.positive? %>
  <div class="note-box">
    <strong><%= money(@summary.escrow_balance) %></strong> of escrow is held by your carrier. It is
    recorded but deliberately kept out of the figures above, because escrow is a refundable deposit
    rather than money spent — counting it would understate your profit and overstate your cost per
    mile. Confirm the deduction treatment with your accountant before filing.
  </div>
<% end %>

<div class="note-box">
  Expenses are the single source of truth for money spent. Fuel logs and maintenance
  records track odometer readings and service history, and their cost fields are for
  reference only, so a fill-up or repair entered in both places is never counted twice.
</div>

<% unless @summary.reconciled? %>
  <h2 class="section-title">Needs Reconciling</h2>
  <div class="note-box is-warning">
    You logged <strong><%= money(@summary.unreconciled_total) %></strong> more in fuel and
    maintenance costs this period than you recorded as expenses, so that money is
    <strong>not</strong> in the statement above. The records below are the ones with no
    expense that lines up with them. Add a matching expense if the cost is real, or clear
    the cost field if it was only a note to yourself.
  </div>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Source</th>
          <th>Date</th>
          <th>Truck</th>
          <th>Detail</th>
          <th class="align-right">Unrecorded Amount</th>
          <th class="align-right">Action</th>
        </tr>
      </thead>
      <tbody>
        <% @summary.unmatched_fuel_logs.each do |log| %>
          <tr>
            <td><span class="badge badge-info">Fuel</span></td>
            <td><%= log.fuel_date %></td>
            <td><%= log.truck&.display_name %></td>
            <td><%= log.station.presence || log.location.presence || "-" %></td>
            <td class="align-right text-warning"><strong><%= money(log.total_cost) %></strong></td>
            <td class="align-right">
              <%= link_to "Add expense", new_expense_path(truck_id: log.truck_id, category: "fuel", amount: log.total_cost, expense_date: log.fuel_date, vendor: log.station.presence || log.location, gallons: log.gallons), class: "btn-link" %>
            </td>
          </tr>
        <% end %>
        <% @summary.unmatched_maintenances.each do |record| %>
          <tr>
            <td><span class="badge badge-neutral">Maintenance</span></td>
            <td><%= record.maintenance_date %></td>
            <td><%= record.truck&.display_name %></td>
            <td><%= record.maintenance_type.to_s.humanize %></td>
            <td class="align-right text-warning"><strong><%= money(record.cost) %></strong></td>
            <td class="align-right">
              <%= link_to "Add expense", new_expense_path(truck_id: record.truck_id, category: "maintenance", amount: record.cost, expense_date: record.maintenance_date, vendor: record.vendor), class: "btn-link" %>
            </td>
          </tr>
        <% end %>
        <tr class="statement-total">
          <td colspan="4">Total not counted in this statement</td>
          <td class="align-right text-warning"><strong><%= money(@summary.unreconciled_total) %></strong></td>
          <td></td>
        </tr>
      </tbody>
    </table>
  </div>
<% end %>
