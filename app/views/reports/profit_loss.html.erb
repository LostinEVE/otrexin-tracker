<% content_for :title, "Profit & Loss" %>

<div class="page-header">
  <div class="page-title-group">
    <h1>Profit &amp; Loss Statement</h1>
    <p class="page-kicker">Bank and tax-ready summary for the selected truck and date range.</p>
  </div>
</div>

<%= form_with url: reports_profit_loss_path, method: :get, local: true, class: "filter-bar is-wide" do |f| %>
  <div class="field">
    <%= f.label :truck_id, "Truck" %>
    <%= f.select :truck_id,
      options_from_collection_for_select(current_trucks, :id, :display_name, selected_truck&.id),
      { include_blank: "All trucks" } %>
  </div>
  <div class="field">
    <%= f.label :start_date, "Start Date" %>
    <%= f.date_field :start_date, value: @start_date %>
  </div>
  <div class="field">
    <%= f.label :end_date, "End Date" %>
    <%= f.date_field :end_date, value: @end_date %>
  </div>
  <div class="field">
    <%= f.submit "Run Report" %>
  </div>
<% end %>

<div class="action-bar">
  <%= link_to "Export CSV", reports_profit_loss_path(format: :csv, truck_id: selected_truck&.id, start_date: @start_date, end_date: @end_date), class: "btn btn-secondary" %>
  <a href="#" onclick="window.print();return false;" class="btn btn-secondary">Print / Save PDF</a>
</div>

<div class="metric-grid">
  <div class="metric-card">
    <div class="metric-label">Revenue</div>
    <div class="metric-value text-success">$<%= number_with_precision(@revenue_total, precision: 2, delimiter: ",") %></div>
  </div>
  <div class="metric-card">
    <div class="metric-label">Operating Costs</div>
    <div class="metric-value text-danger">$<%= number_with_precision(@operating_cost_total, precision: 2, delimiter: ",") %></div>
  </div>
  <div class="metric-card">
    <div class="metric-label">Net Profit</div>
    <div class="metric-value <%= @net_profit >= 0 ? 'text-success' : 'text-danger' %>">$<%= number_with_precision(@net_profit, precision: 2, delimiter: ",") %></div>
  </div>
  <div class="metric-card">
    <div class="metric-label">Revenue / Mile</div>
    <div class="metric-value"><%= @revenue_per_mile ? "$#{@revenue_per_mile}" : "-" %></div>
  </div>
  <div class="metric-card">
    <div class="metric-label">Cost / Mile</div>
    <div class="metric-value"><%= @cost_per_mile ? "$#{@cost_per_mile}" : "-" %></div>
  </div>
  <div class="metric-card">
    <div class="metric-label">Tax Adjustments</div>
    <div class="metric-value text-info">$<%= number_with_precision(@tax_adjustment_total, precision: 2, delimiter: ",") %></div>
  </div>
  <div class="metric-card">
    <div class="metric-label">Taxable Profit Est.</div>
    <div class="metric-value <%= @taxable_profit_estimate >= 0 ? 'text-success' : 'text-danger' %>">$<%= number_with_precision(@taxable_profit_estimate, precision: 2, delimiter: ",") %></div>
  </div>
</div>

<div class="content-grid">
  <section class="panel">
    <div class="panel-header">
      <h3 class="panel-title">Statement Summary</h3>
    </div>
    <div class="table-wrap">
      <table>
        <tbody>
          <tr><td>Revenue</td><td class="align-right">$<%= number_with_precision(@revenue_total, precision: 2) %></td></tr>
          <tr><td>Expense Total</td><td class="align-right">$<%= number_with_precision(@expense_total, precision: 2) %></td></tr>
          <tr><td>Maintenance Total</td><td class="align-right">$<%= number_with_precision(@maintenance_total, precision: 2) %></td></tr>
          <tr><td><strong>Operating Cost Total</strong></td><td class="align-right"><strong>$<%= number_with_precision(@operating_cost_total, precision: 2) %></strong></td></tr>
          <tr><td><strong>Net Profit</strong></td><td class="align-right"><strong>$<%= number_with_precision(@net_profit, precision: 2) %></strong></td></tr>
          <tr><td>Per Diem Deductions</td><td class="align-right">$<%= number_with_precision(@per_diem_total, precision: 2) %></td></tr>
          <tr><td>Depreciation Deductions</td><td class="align-right">$<%= number_with_precision(@depreciation_total, precision: 2) %></td></tr>
          <tr><td><strong>Taxable Profit Estimate</strong></td><td class="align-right"><strong>$<%= number_with_precision(@taxable_profit_estimate, precision: 2) %></strong></td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="panel">
    <div class="panel-header">
      <h3 class="panel-title">Expense Breakdown by Category</h3>
    </div>
    <% if @expense_by_category.any? %>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Category</th>
              <th class="align-right">Amount</th>
            </tr>
          </thead>
          <tbody>
            <% @expense_by_category.each do |category, amount| %>
              <tr>
                <td><%= category.to_s.humanize %></td>
                <td class="align-right">$<%= number_with_precision(amount, precision: 2) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="panel-body">
        <p>No expense data for this period.</p>
      </div>
    <% end %>
  </section>
</div>
