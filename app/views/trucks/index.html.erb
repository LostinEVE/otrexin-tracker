<% content_for :title, "Trucks" %>

<div class="page-header">
  <div class="page-title-group">
    <h1>Truck Manager</h1>
    <p class="page-kicker">Manage the trucks used across invoices, trips, fuel entries, expenses, and maintenance records.</p>
  </div>
  <div class="action-bar">
    <%= link_to "Add Truck", new_truck_path, class: "btn" %>
  </div>
</div>

<div class="record-list">
  <% if @trucks.any? %>
    <% @trucks.each do |truck| %>
      <div class="record-card">
        <div class="record-main">
          <div>
            <h3 class="record-title"><%= truck.display_name %></h3>
            <div class="record-subtitle"><%= [truck.year, truck.make, truck.model].compact_blank.join(" ").presence || "No truck details added yet." %></div>
          </div>
          <span class="badge <%= truck.active? ? 'badge-success' : 'badge-neutral' %>"><%= truck.active? ? "Active" : "Inactive" %></span>
        </div>

        <% if truck.vin.present? %>
          <div class="record-meta-grid">
            <div class="meta-item">
              <div class="meta-label">VIN</div>
              <div class="meta-value"><%= truck.vin %></div>
            </div>
          </div>
        <% end %>

        <div class="record-actions">
          <%= link_to "Edit", edit_truck_path(truck), class: "btn btn-secondary" %>
          <%= link_to "View Trips", mileages_path(truck_id: truck.id), class: "btn btn-secondary" %>
          <%= link_to "Delete", truck_path(truck), data: { turbo_method: :delete, turbo_confirm: "Delete this truck?" }, class: "btn btn-danger" %>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="empty-state">No trucks have been added yet.</div>
  <% end %>
</div>
