<%= form_with(model: truck, class: "form-card") do |form| %>
  <% if truck.errors.any? %>
    <div class="form-errors">
      <h3><%= pluralize(truck.errors.count, "error") %> stopped this truck from saving:</h3>
      <ul>
        <% truck.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-grid">
    <div class="field">
      <%= form.label :name, "Truck Name" %>
      <%= form.text_field :name, placeholder: "Primary Truck" %>
    </div>

    <div class="two-col">
      <div class="field">
        <%= form.label :unit_number, "Unit Number" %>
        <%= form.text_field :unit_number, placeholder: "Truck 12" %>
      </div>
      <div class="field">
        <%= form.label :vin, "VIN" %>
        <%= form.text_field :vin, placeholder: "Optional" %>
      </div>
    </div>

    <div class="three-col">
      <div class="field">
        <%= form.label :year, "Year" %>
        <%= form.number_field :year, placeholder: "2024" %>
      </div>
      <div class="field">
        <%= form.label :make, "Make" %>
        <%= form.text_field :make, placeholder: "Freightliner" %>
      </div>
      <div class="field">
        <%= form.label :model, "Model" %>
        <%= form.text_field :model, placeholder: "Cascadia" %>
      </div>
    </div>

    <div class="field">
      <%= form.label :baseline_odometer, "Starting Odometer" %>
      <%= form.number_field :baseline_odometer, placeholder: "Optional" %>
      <p class="field-hint">
        The reading on this truck when you started tracking it. Without it, the miles you
        drove before your very first fuel entry cannot be counted. Leave blank if you are
        not sure — a wrong number here is ignored rather than trusted.
      </p>
    </div>

    <label class="checkbox-field">
      <%= form.check_box :active %>
      Active truck
    </label>

    <div class="action-bar">
      <%= form.submit truck.persisted? ? "Update Truck" : "Save Truck" %>
    </div>
  </div>
<% end %>
