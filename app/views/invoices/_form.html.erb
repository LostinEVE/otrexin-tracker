<%= form_with(model: invoice, class: "form-card") do |form| %>
  <% if invoice.errors.any? %>
    <div class="form-errors">
      <h3><%= pluralize(invoice.errors.count, "error") %> stopped this invoice from saving:</h3>
      <ul>
        <% invoice.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-grid">
    <h3>Load Details</h3>

    <div class="field">
      <%= form.label :truck_id, "Truck" %>
      <%= form.collection_select :truck_id, @trucks, :id, :display_name, { prompt: "Select a truck" } %>
    </div>

    <div class="two-col">
      <div class="field">
        <%= form.label :invoice_number, "Invoice #" %>
        <%= form.text_field :invoice_number, placeholder: "001" %>
      </div>
      <div class="field">
        <%= form.label :invoice_date, "Invoice Date" %>
        <%= form.date_field :invoice_date %>
      </div>
    </div>

    <div class="field">
      <%= form.label :customer_name, "Customer Name" %>
      <%= form.text_field :customer_name, placeholder: "ABC Freight Co." %>
    </div>

    <div class="two-col">
      <div class="field">
        <%= form.label :load_number, "Load Number" %>
        <%= form.text_field :load_number, placeholder: "LOAD-5001" %>
      </div>
      <div class="field">
        <%= form.label :delivery_date, "Date Delivered" %>
        <%= form.date_field :delivery_date %>
      </div>
    </div>

    <div class="two-col">
      <div class="field">
        <%= form.label :amount, "Amount to be Paid ($)" %>
        <%= form.number_field :amount, step: "0.01", placeholder: "2500.00" %>
      </div>
      <div class="field">
        <%= form.label :status, "Payment Status" %>
        <%= form.select :status, [["Unpaid", "unpaid"], ["Paid", "paid"]] %>
      </div>
    </div>

    <div class="field">
      <%= form.label :product_description, "Product Description" %>
      <%= form.text_field :product_description, placeholder: "Dry goods, steel coils..." %>
    </div>

    <div class="two-col">
      <div class="field">
        <%= form.label :piece_count, "Piece Count" %>
        <%= form.number_field :piece_count, placeholder: "0" %>
      </div>
      <div class="field">
        <%= form.label :rate_per_piece, "Rate Per Piece ($)" %>
        <%= form.number_field :rate_per_piece, step: "0.01", placeholder: "0.00" %>
      </div>
    </div>

    <div class="field">
      <%= form.label :notes, "Notes" %>
      <%= form.text_area :notes, rows: 3, placeholder: "Broker, rate confirmation, special instructions..." %>
    </div>

    <div class="action-bar">
      <%= form.submit "Save Invoice" %>
    </div>
  </div>
<% end %>
