<% content_for :title, "Edit Invoice" %>

<div class="page-header">
  <div class="page-title-group">
    <h1>Edit Invoice</h1>
    <p class="page-kicker">Update invoice details, status, and load information.</p>
  </div>
</div>

<%= render "form", invoice: @invoice %>

<div class="page-footer-actions">
  <%= link_to "View Invoice", @invoice, class: "btn btn-secondary" %>
  <%= link_to "Back to Invoices", invoices_path, class: "btn btn-secondary" %>
</div>
