<% content_for :title, "Invoice ##{@invoice.invoice_number}" %>
<% company = current_company_profile %>

<section class="panel invoice-document">
  <div class="panel-body">
    <div class="invoice-document-header">
      <div class="invoice-company">
        <h2><%= company.company_name.presence || "Your Company Name" %></h2>
        <div><%= company.address_line1 %></div>
        <div><%= company.address_line2 %></div>
        <div><%= company.city_state_zip %></div>
        <% if company.contact_line.present? %>
          <div class="text-muted"><%= company.contact_line %></div>
        <% end %>
      </div>

      <div class="invoice-summary">
        <div class="invoice-title">INVOICE</div>
        <div><strong>#</strong> <%= @invoice.invoice_number %></div>
        <div><strong>Invoice Date:</strong> <%= @invoice.invoice_date %></div>
        <div><strong>Delivery Date:</strong> <%= @invoice.delivery_date %></div>
        <span class="badge <%= @invoice.status == 'paid' ? 'badge-success' : 'badge-warning' %>"><%= @invoice.status %></span>
      </div>
    </div>

    <div class="invoice-bill-to">
      <div class="eyebrow">Bill To</div>
      <div class="invoice-bill-name"><%= @invoice.customer_name %></div>
      <div class="text-muted">Load #<%= @invoice.load_number %></div>
    </div>

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Description</th>
            <th class="align-right">Pieces</th>
            <th class="align-right">Rate</th>
            <th class="align-right">Amount</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><%= @invoice.product_description.presence || "Freight services" %></td>
            <td class="align-right"><%= @invoice.piece_count.presence || "-" %></td>
            <td class="align-right"><%= @invoice.rate_per_piece.present? ? "$#{number_with_precision(@invoice.rate_per_piece, precision: 2)}" : "-" %></td>
            <td class="align-right"><strong>$<%= number_with_precision(@invoice.amount, precision: 2) %></strong></td>
          </tr>
        </tbody>
      </table>
    </div>

    <% if @invoice.notes.present? %>
      <p class="record-note"><strong>Notes:</strong> <%= @invoice.notes %></p>
    <% end %>
  </div>
</section>

<div class="page-footer-actions">
  <%= link_to "Edit Invoice", edit_invoice_path(@invoice), class: "btn btn-secondary" %>
  <%= link_to "Back to Invoices", invoices_path, class: "btn btn-secondary" %>
  <%= link_to "Email Invoice", email_invoice_path(@invoice), class: "btn" %>
  <a href="#" onclick="window.print(); return false;" class="btn btn-secondary">Print / Save PDF</a>
  <%= button_to "Delete Invoice", @invoice, method: :delete, class: "btn btn-danger" %>
</div>
