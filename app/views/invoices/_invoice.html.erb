<div id="<%= dom_id invoice %>" class="record-card">
  <div class="record-main">
    <div>
      <h3 class="record-title">Invoice #<%= invoice.invoice_number %></h3>
      <div class="record-subtitle">
        <%= invoice.customer_name %> - <%= invoice.invoice_date %> - <%= invoice.truck.display_name %>
      </div>
    </div>
    <div>
      <div class="record-amount">$<%= number_with_precision(invoice.amount, precision: 2) %></div>
      <span class="badge <%= invoice.status == 'paid' ? 'badge-success' : 'badge-warning' %>"><%= invoice.status %></span>
    </div>
  </div>

  <div class="record-meta-grid">
    <div class="meta-item">
      <div class="meta-label">Load</div>
      <div class="meta-value"><%= invoice.load_number.presence || "-" %></div>
    </div>
    <div class="meta-item">
      <div class="meta-label">Delivered</div>
      <div class="meta-value"><%= invoice.delivery_date || "-" %></div>
    </div>
    <div class="meta-item">
      <div class="meta-label">Product</div>
      <div class="meta-value"><%= invoice.product_description.presence || "Freight services" %></div>
    </div>
  </div>

  <% if invoice.notes.present? %>
    <p class="record-note"><%= invoice.notes %></p>
  <% end %>

  <div class="record-actions">
    <%= link_to "View", invoice_path(invoice), class: "btn btn-secondary" %>
    <%= link_to "Email", email_invoice_path(invoice), class: "btn btn-secondary" %>
    <%= link_to "Edit", edit_invoice_path(invoice), class: "btn btn-secondary" %>
  </div>
</div>
