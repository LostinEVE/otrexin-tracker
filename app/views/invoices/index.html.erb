<% content_for :title, "Invoices" %>

<div class="page-header">
  <div class="page-title-group">
    <h1>Invoices</h1>
    <p class="page-kicker">Create, track, print, and email customer invoices.</p>
  </div>
  <div class="action-bar">
    <%= link_to "New Invoice", new_invoice_path(truck_id: selected_truck&.id), class: "btn" %>
  </div>
</div>

<%= form_with url: invoices_path, method: :get, local: true, class: "filter-bar" do |f| %>
  <div class="field">
    <%= f.label :truck_id, "Truck" %>
    <%= f.select :truck_id,
      options_from_collection_for_select(@trucks, :id, :display_name, selected_truck&.id),
      { include_blank: "All trucks" } %>
  </div>
  <div class="field">
    <%= f.submit "Filter" %>
  </div>
<% end %>

<div id="invoices" class="record-list">
  <% if @invoices.any? %>
    <% @invoices.each do |invoice| %>
      <%= render invoice %>
    <% end %>
  <% else %>
    <div class="empty-state">No invoices yet.</div>
  <% end %>
</div>
