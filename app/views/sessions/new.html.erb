<% content_for :title, "Sign In" %>

<div class="page-header">
  <div class="page-title-group">
    <h1>Sign In</h1>
    <p class="page-kicker">Access your trucking records and reports.</p>
  </div>
</div>

<%= form_with url: login_path, method: :post, local: true, class: "form-card" do |f| %>
  <div class="form-grid">
    <div class="field">
      <%= f.label :email, "Email" %>
      <%= f.email_field :email, required: true %>
    </div>
    <div class="field">
      <%= f.label :password, "Password" %>
      <%= f.password_field :password, required: true %>
    </div>
    <div class="action-bar">
      <%= f.submit "Sign In" %>
    </div>
  </div>
<% end %>

<p>Need an account? <%= link_to "Create one", signup_path %></p>
