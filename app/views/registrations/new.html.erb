<% content_for :title, "Create Account" %>

<div class="page-header">
  <div class="page-title-group">
    <h1>Create Account</h1>
    <p class="page-kicker">Create a secure workspace for your trucking records.</p>
  </div>
</div>

<% if @user.errors.any? %>
  <div class="form-errors">
    <h3><%= pluralize(@user.errors.count, "error") %> stopped signup:</h3>
    <ul>
      <% @user.errors.each do |error| %>
        <li><%= error.full_message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @user, url: signup_path, method: :post, local: true, class: "form-card" do |f| %>
  <div class="form-grid">
    <div class="field">
      <%= f.label :email, "Email" %>
      <%= f.email_field :email, required: true %>
    </div>
    <div class="field">
      <%= f.label :password, "Password" %>
      <%= f.password_field :password, required: true %>
    </div>
    <div class="field">
      <%= f.label :password_confirmation, "Confirm Password" %>
      <%= f.password_field :password_confirmation, required: true %>
    </div>
    <div class="action-bar">
      <%= f.submit "Create Account" %>
    </div>
  </div>
<% end %>

<p>Already have an account? <%= link_to "Sign in", login_path %></p>
