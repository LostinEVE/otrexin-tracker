<% content_for :title, "Support" %>

<div class="page-header">
  <div class="page-title-group">
    <h1>Support</h1>
    <p class="page-kicker">Optional support for continued development.</p>
  </div>
</div>

<div class="content-grid">
  <section class="panel">
    <div class="panel-body">
      <h3>Support This App</h3>
      <p>If this tracker helps your business, you can support continued development.</p>
      <p>This is optional and not a product checkout.</p>
    </div>
  </section>

  <section class="panel">
    <div class="panel-body">
      <h3>PayPal Tip Jar</h3>

      <% if @coffee_url.present? %>
        <p>Send support with PayPal.</p>
        <div class="action-bar">
          <a href="<%= @coffee_url %>" target="_blank" rel="noopener" class="btn">Buy Me a Coffee</a>
          <%= link_to "I Sent Support", support_thank_you_path, class: "btn btn-secondary" %>
        </div>
      <% else %>
        <div class="alert alert-danger">PAYPAL_BUY_ME_COFFEE_URL is not configured.</div>
        <p>Set <code>PAYPAL_BUY_ME_COFFEE_URL</code> in your environment to enable the support link.</p>
      <% end %>
    </div>
  </section>
</div>
