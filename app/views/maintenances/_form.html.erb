<% service_types = [
  ["Oil Change", "oil_change"],
  ["Tire Rotation", "tire_rotation"],
  ["Brake Inspection / Repair", "brake_inspection"],
  ["DOT Inspection", "dot_inspection"],
  ["Tire Replacement", "tire_replacement"],
  ["Engine Repair", "engine_repair"],
  ["Transmission", "transmission"],
  ["PM Service", "pm_service"],
  ["Other", "other"]
] %>

<%= form_with(model: maintenance, class: "form-card") do |form| %>
  <% if maintenance.errors.any? %>
    <div class="form-errors">
      <h3><%= pluralize(maintenance.errors.count, "error") %> stopped this record from saving:</h3>
      <ul>
        <% maintenance.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-grid">
    <div class="two-col">
      <div class="field">
        <%= form.label :truck_id, "Truck" %>
        <%= form.collection_select :truck_id, @trucks, :id, :display_name, { prompt: "Select a truck" } %>
      </div>
      <div class="field">
        <%= form.label :maintenance_date, "Service Date" %>
        <%= form.date_field :maintenance_date %>
      </div>
    </div>

    <div class="two-col">
      <div class="field">
        <%= form.label :odometer, "Odometer" %>
        <%= form.number_field :odometer, placeholder: "123456" %>
      </div>
      <div class="field">
        <%= form.label :maintenance_type, "Service Type" %>
        <%= form.select :maintenance_type, service_types, { include_blank: "Select Type" } %>
      </div>
    </div>

    <div class="two-col">
      <div class="field">
        <%= form.label :cost, "Cost ($)" %>
        <%= form.number_field :cost, step: "0.01", placeholder: "250.00" %>
        <p class="field-hint">For your records. Log the money as an expense under Maintenance &amp; Repairs to have it count in your P&amp;L.</p>
      </div>
      <div class="field">
        <%= form.label :vendor, "Shop / Vendor" %>
        <%= form.text_field :vendor, placeholder: "Speedco, Love's, etc." %>
      </div>
    </div>

    <div class="field">
      <%= form.label :notes, "Notes" %>
      <%= form.text_area :notes, rows: 2 %>
    </div>

    <div class="action-bar">
      <%= form.submit "Save Record" %>
    </div>
  </div>
<% end %>
