<% content_for :title, "Maintenance Record" %>

<div class="page-header">
  <div class="page-title-group">
    <h1>Maintenance Record</h1>
  </div>
</div>

<%= render @maintenance %>

<div class="page-footer-actions">
  <%= link_to "Edit Record", edit_maintenance_path(@maintenance), class: "btn btn-secondary" %>
  <%= link_to "Back to Maintenance", maintenances_path, class: "btn btn-secondary" %>
  <%= button_to "Delete Record", @maintenance, method: :delete, class: "btn btn-danger" %>
</div>
