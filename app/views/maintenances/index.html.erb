<% content_for :title, "Maintenance" %>

<% total_cost = @maintenances.sum(:cost) %>
<% total_records = @maintenances.count %>
<% mtd_cost = @maintenances.where("maintenance_date >= ?", Date.current.beginning_of_month).sum(:cost) %>

<div class="page-header">
  <div class="page-title-group">
    <h1>Maintenance Log</h1>
    <p class="page-kicker">Track service work, repairs, vendors, and maintenance cost by truck.</p>
  </div>
  <div class="action-bar">
    <%= link_to "Export CSV", maintenances_path(format: :csv, truck_id: selected_truck&.id, start_date: @start_date, end_date: @end_date), class: "btn btn-secondary" %>
    <%= link_to "Add Service Record", new_maintenance_path(truck_id: selected_truck&.id), class: "btn" %>
  </div>
</div>

<%= form_with url: maintenances_path, method: :get, local: true, class: "filter-bar" do |f| %>
  <div class="field">
    <%= f.label :truck_id, "Truck" %>
    <%= f.select :truck_id,
      options_from_collection_for_select(@trucks, :id, :display_name, selected_truck&.id),
      { include_blank: "All trucks" } %>
  </div>
  <div class="field">
    <%= f.label :start_date, "Start Date" %>
    <%= f.date_field :start_date, value: @start_date %>
  </div>
  <div class="field">
    <%= f.label :end_date, "End Date" %>
    <%= f.date_field :end_date, value: @end_date %>
  </div>
  <div class="field">
    <%= f.submit "Filter" %>
  </div>
<% end %>

<div class="metric-grid">
  <div class="metric-card">
    <div class="metric-label">Service Records</div>
    <div class="metric-value"><%= total_records %></div>
  </div>
  <div class="metric-card">
    <div class="metric-label">Total Maintenance Cost</div>
    <div class="metric-value text-danger"><%= money(total_cost) %></div>
    <div class="metric-note">Reference only</div>
  </div>
  <div class="metric-card">
    <div class="metric-label">This Month</div>
    <div class="metric-value text-danger"><%= money(mtd_cost) %></div>
    <div class="metric-note">Reference only</div>
  </div>
</div>

<div class="note-box">
  This log is your service history. The costs shown here are <strong>not</strong> counted
  in your P&amp;L or cost per mile — record the money as an expense under
  <strong>Maintenance &amp; Repairs</strong> so it is only counted once.
  <%= link_to "Add the expense", new_expense_path(category: "maintenance", truck_id: selected_truck&.id), class: "btn-link" %>
</div>

<div id="maintenances" class="record-list">
  <% if @maintenances.any? %>
    <% @maintenances.order(maintenance_date: :desc).each do |maintenance| %>
      <%= render maintenance %>
    <% end %>
  <% else %>
    <div class="empty-state">No maintenance records found.</div>
  <% end %>
</div>
