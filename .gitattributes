# See https://git-scm.com/docs/gitattributes for more about git attribute files.

# One line-ending convention for the whole repository: LF in the repo and in
# working trees, whatever platform commits. Later, more specific patterns
# below override this where they must.
* text=auto eol=lf

# Mark the database schema as having been generated.
db/schema.rb linguist-generated

# Binstubs are executed directly by CI and by the container entrypoint, so they
# must keep Unix line endings whatever platform commits them. A CRLF shebang
# makes the kernel look for an interpreter named "ruby\r" and the script dies
# with "bad interpreter". The .cmd wrapper is for Windows and keeps CRLF.
bin/* text eol=lf
bin/*.cmd text eol=crlf

# Statement fixtures are hand-verified against real settlements and frozen —
# no conversion of any kind may ever rewrite them.
test/fixtures/files/* -text

# Mark any vendored files as having been vendored.
vendor/* linguist-vendored
config/credentials/*.yml.enc diff=rails_credentials
config/credentials.yml.enc diff=rails_credentials
